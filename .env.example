# SQLite (chemin relatif au dossier prisma/)
DATABASE_URL="file:../data/kouziacrm.db"

# Session cookie (générer: openssl rand -base64 32)
SESSION_SECRET="change-me-generate-a-strong-secret"
# Compat legacy NextAuth (si SESSION_SECRET absente)
# AUTH_SECRET="..."

# Origine du front (CORS + garde Origin). En dev, localhost et 127.0.0.1 sont tous deux acceptés.
WEB_ORIGIN="http://localhost:5173"
# Origine optionnelle pour le suivi public / iframe vitrine
# PUBLIC_WEB_ORIGIN="http://localhost:5173"
# En prod derrière HTTPS / tunnel: WEB_ORIGIN=https://gestion.exemple.fr et COOKIE_SECURE=true
COOKIE_SECURE="false"
API_PORT="3001"
# Prod: chemin du build SPA servi par l'API (docker compose le fixe)
# WEB_DIST="/app/apps/web/dist"
# Trust proxy (Cloudflare Tunnel / reverse-proxy). true seulement derrière un proxy de confiance.
# TRUST_PROXY="true"

# Chiffrement AES-256-GCM des champs sensibles (64 hex chars = 32 bytes)
# openssl rand -hex 32
# INTERDIT en prod: la clé d'exemple ci-dessous est rejetée au boot.
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Compte admin (seed)
# En production: OBLIGATOIRE, >= 12 caractères, non devinable.
# Générer: openssl rand -base64 24
ADMIN_EMAIL="admin@kouzia.com"
ADMIN_PASSWORD="CHANGE-ME-openssl-rand-base64-24"
ADMIN_NAME="Alexandre Kouziaeff"

# SMTP (envoi emails)
# Dev local (Mailpit): make mailpit / inclus dans make dev
SMTP_HOST="127.0.0.1"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_USER="dev"
SMTP_PASS="dev"
SMTP_FROM="Kouzia <dev@localhost>"
# Prod (OVH / Gmail / etc.):
# SMTP_HOST="ssl0.ovh.net"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="contact@exemple.fr"
# SMTP_PASS="…"
# SMTP_FROM="Kouzia <contact@exemple.fr>"

# IMAP (polling boîte mail - optionnel en local)
IMAP_HOST=""
IMAP_PORT="993"
IMAP_SECURE="true"
IMAP_USER=""
IMAP_PASS=""
IMAP_MAILBOX="INBOX"

# Uploads pièces jointes obligations (défaut: data/uploads/obligations)
# UPLOADS_DIR="./data/uploads/obligations"

# Cloudflare Tunnel (Proxmox): optionnel si service cloudflared décommenté
# CLOUDFLARE_TUNNEL_TOKEN=""
