# SQLite (chemin relatif au dossier prisma/)
DATABASE_URL="file:../data/kouziacrm.db"

# Session cookie (générer: openssl rand -base64 32)
SESSION_SECRET="change-me-generate-a-strong-secret"
# Compat legacy NextAuth (si SESSION_SECRET absente)
# AUTH_SECRET="..."

# Origine du front admin ERP (CORS + garde Origin). En dev, localhost et 127.0.0.1 sont tous deux acceptés.
WEB_ORIGIN="http://localhost:5173"
# Origine du site public kouzia.fr : CORS pour /api/public/* et lien /nouveau-client dans les emails clients.
# Dev local (site Kouzia sur :5174, admin ERP sur :5173) : PUBLIC_WEB_ORIGIN="http://localhost:5174"
# Prod : PUBLIC_WEB_ORIGIN="https://kouzia.fr"
PUBLIC_WEB_ORIGIN="https://kouzia.fr"
# Secret HMAC des liens d'invitation client (distinct de SESSION_SECRET).
# openssl rand -hex 32
ONBOARDING_HMAC_SECRET="change-me-onboarding-hmac-openssl-rand-hex-32"
# Durée de validité des liens /nouveau-client (jours)
ONBOARDING_TOKEN_TTL_DAYS="7"
# Dev : http://localhost:5174/suivi | Prod : https://kouzia.com/suivi
CLIENT_PORTAL_URL="https://kouzia.com/suivi"
# Dev : http://localhost:5174 | Prod : https://kouzia.fr
VITE_PUBLIC_SITE_URL="https://kouzia.fr"
# En prod derrière HTTPS / tunnel: COOKIE_SECURE=true
# En HTTP LAN (IP du CT) : COOKIE_SECURE=false (obligatoire, sinon cookies + assets cassés)
COOKIE_SECURE="false"
API_PORT="3001"
# Prod: chemin du build SPA servi par l'API (docker compose le fixe)
# WEB_DIST="/app/apps/web/dist"
# Trust proxy (Cloudflare Tunnel / reverse-proxy). true seulement derrière un proxy de confiance.
# TRUST_PROXY="true"

# Chiffrement AES-256-GCM des champs sensibles (64 hex chars = 32 bytes)
# openssl rand -hex 32
# INTERDIT en prod: la clé d'exemple ci-dessous est rejetée au boot.
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Compte admin (seed)
# En production: OBLIGATOIRE, >= 12 caractères, non devinable.
# Générer: openssl rand -base64 24
ADMIN_EMAIL="admin@kouzia.com"
ADMIN_PASSWORD="CHANGE-ME-openssl-rand-base64-24"
ADMIN_NAME="Alexandre Kouziaeff"

# SMTP (envoi emails) - fallback si non renseigné dans Paramètres ERP
# Dev local (Mailpit): make mailpit / inclus dans make dev
SMTP_HOST="127.0.0.1"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_USER="dev"
SMTP_PASS="dev"
SMTP_FROM="Kouzia <dev@localhost>"
# Prod Hostinger (ou renseigner via Paramètres > Emails & Messagerie) :
# SMTP_HOST="smtp.hostinger.com"
# SMTP_PORT="465"
# SMTP_SECURE="true"
# SMTP_USER="contact@kouzia.com"
# SMTP_PASS="…"
# SMTP_FROM="KOUZIA <contact@kouzia.com>"

# IMAP (polling boîte mail - optionnel en local ; préférer Paramètres ERP en prod)
# Hostinger : imap.hostinger.com:993 SSL
IMAP_HOST=""
IMAP_PORT="993"
IMAP_SECURE="true"
IMAP_USER=""
IMAP_PASS=""
IMAP_MAILBOX="INBOX"

# URL publique de l'API (webhooks Revolut Merchant). En prod, souvent = WEB_ORIGIN.
# PUBLIC_API_ORIGIN="https://gestion.kouzia.fr"

# Uploads pièces jointes obligations (défaut: data/uploads/obligations)
# UPLOADS_DIR="./data/uploads/obligations"

# Cloudflare Tunnel (Proxmox): optionnel si service cloudflared décommenté
# CLOUDFLARE_TUNNEL_TOKEN=""

# Revolut Business API (rapprochement bancaire)
# Clé privée PEM (\\n pour les retours ligne) - jamais committer
# REVOLUT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----"
# REVOLUT_CLIENT_UUID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
# REVOLUT_REFRESH_TOKEN="..."
# REVOLUT_ENV="sandbox"   # sandbox | production
# REVOLUT_ACCOUNT_ID=""   # optionnel: filtrer un compte
# REVOLUT_JWT_ISS=""      # optionnel: iss JWT (défaut = client UUID)
# REVOLUT_PAYOUT_ENABLED="true"  # brouillons virement salaire (bouton Accueil)
