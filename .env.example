# SQLite (chemin relatif au dossier prisma/)
DATABASE_URL="file:../data/kouziacrm.db"

# Session cookie (générer: openssl rand -base64 32)
SESSION_SECRET="change-me-generate-a-strong-secret"
# Compat ancienne var NextAuth (utilisée si SESSION_SECRET absente)
# AUTH_SECRET="..."

# Origine du front (CORS + garde Origin). En dev, localhost et 127.0.0.1 sont tous deux acceptés.
WEB_ORIGIN="http://localhost:5173"
# Origine optionnelle pour le suivi public client
# PUBLIC_WEB_ORIGIN="http://localhost:5173"
# En prod derrière HTTPS / tunnel: WEB_ORIGIN=https://gestion.exemple.fr et COOKIE_SECURE=true
COOKIE_SECURE="false"
API_PORT="3001"

# Chiffrement AES-256-GCM des champs sensibles (64 hex chars = 32 bytes)
# openssl rand -hex 32
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Compte admin (seed)
ADMIN_EMAIL="admin@kouzia.com"
ADMIN_PASSWORD="1234"
ADMIN_NAME="Alexandre Kouziaeff"

# SMTP (envoi emails)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# IMAP (polling boîte mail)
IMAP_HOST=""
IMAP_PORT="993"
IMAP_SECURE="true"
IMAP_USER=""
IMAP_PASS=""
IMAP_MAILBOX="INBOX"

# Cloudflare Tunnel (Proxmox) — optionnel si service cloudflared décommenté
# CLOUDFLARE_TUNNEL_TOKEN=""
