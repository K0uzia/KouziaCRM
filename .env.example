# SQLite (chemin relatif au dossier prisma/)
DATABASE_URL="file:../data/kouziacrm.db"

# Auth.js — générer avec: openssl rand -base64 32
AUTH_SECRET="change-me-generate-a-strong-secret"
AUTH_URL="http://localhost:3000"

# Chiffrement AES-256-GCM des champs sensibles (64 hex chars = 32 bytes)
# openssl rand -hex 32
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Compte admin (seed)
ADMIN_EMAIL="admin@kouzia.com"
ADMIN_PASSWORD="change-me-on-first-login"
ADMIN_NAME="Alexandre Kouziaeff"

# SMTP (envoi emails)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# IMAP (polling boîte mail)
IMAP_HOST=""
IMAP_PORT="993"
IMAP_SECURE="true"
IMAP_USER=""
IMAP_PASS=""
IMAP_MAILBOX="INBOX"

# Cloudflare Tunnel (Proxmox) — optionnel si service cloudflared décommenté
# CLOUDFLARE_TUNNEL_TOKEN=""
