        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "infos": {
          "type": "object",
          "properties": {
            "email": {
              "type": "string",
              "format": "email",
              "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
            },
            "telephone": {
              "type": "string",
              "pattern": "^0\\d( \\d\\d){4}$"
            },
            "delaiReponse": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\u2013\\u2014]*$"
            },
            "anneesExperience": {
              "type": "integer",
              "minimum": 0,
              "maximum": 80
            },
            "zone": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\u2013\\u2014]*$"
            },
            "villes": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\u2013\\u2014]*$"
              }
            },
            "github": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^https:\\/\\/[^\\s/?#]+[^\\s]*$"
                },
                {
                  "type": "string",
                  "const": ""
                }
              ]
            },
            "instagram": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^https:\\/\\/[^\\s/?#]+[^\\s]*$"
                },
                {
                  "type": "string",
                  "const": ""
                }
              ]
            },
            "ficheGoogle": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^https:\\/\\/[^\\s/?#]+[^\\s]*$"
                },
                {
                  "type": "string",
                  "const": ""
                }
              ]
            },
            "avisGoogle": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^https:\\/\\/[^\\s/?#]+[^\\s]*$"
                },
                {
                  "type": "string",
                  "const": ""
                }
              ]
            }
          },
          "required": [
            "email",
            "telephone",
            "delaiReponse",
            "anneesExperience",
            "zone",
            "villes"
          ],
          "additionalProperties": false
        }
      },
