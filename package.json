{
  "name": "kouzia-erp",
  "version": "2.0.0",
  "private": true,
  "description": "ERP Kouzia : gestion, facturation et suivi client de l'EI Kouzia (micro-entreprise, franchise TVA)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @kouzia-erp/api",
    "dev:web": "wait-on -t 60000 http-get://127.0.0.1:3001/api/health && npm run dev -w @kouzia-erp/web",
    "dev:worker": "wait-on -t 60000 http-get://127.0.0.1:3001/api/health && npm run worker",
    "dev": "node scripts/dev.mjs",
    "check:lockfile": "node scripts/check-lockfile.mjs",
    "check:mobile": "tsx scripts/check-mobile.ts",
    "check:wide": "tsx scripts/check-mobile.ts --widths=768,1024,1280",
    "push:keys": "tsx scripts/push-keys.ts",
    "prebuild": "npm run check:lockfile",
    "build": "npm run build -w @kouzia-erp/web",
    "start": "tsx --env-file=.env --tsconfig apps/api/tsconfig.json apps/api/src/index.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "catalog": "tsx --env-file=.env scripts/apply-catalog.ts",
    "stripe:push-catalog": "tsx --env-file=.env --tsconfig apps/api/tsconfig.json scripts/stripe-push-catalog.ts",
    "mail:repair": "tsx --env-file=.env scripts/mail-repair.ts",
    "seed:mail-demo": "tsx scripts/seed-mail-demo.ts",
    "admin:2fa-reset": "tsx --env-file=.env --tsconfig apps/api/tsconfig.json scripts/admin-2fa-reset.ts",
    "db:studio": "prisma studio",
    "worker": "tsx watch --env-file=.env --tsconfig apps/api/tsconfig.json scripts/worker.ts",
    "pretest": "npm run check:lockfile",
    "test": "npm run test -w @kouzia-erp/api",
    "test:watch": "npm run test:watch -w @kouzia-erp/api",
    "postinstall": "node scripts/ensure-native-deps.mjs"
  },
  "prisma": {
    "seed": "tsx --env-file=.env prisma/seed.ts"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/K0uzia/KouziaCRM.git"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "argon2": "^0.41.1",
    "node-cron": "^4.6.0",
    "prisma": "^6.19.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "concurrently": "^9.2.4",
    "playwright": "^1.64.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "wait-on": "^8.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
