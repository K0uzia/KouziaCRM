generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum ClientType {
  B2B
  B2C
  /// Association (non-professionnel au sens du Code de la consommation)
  ASSOCIATION
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  CANCELLED
}

enum InvoiceDocumentType {
  INVOICE
  CREDIT_NOTE
  QUOTE
}

/// Nature métier de la facture (autonome légalement ; le devis est le pivot marché)
enum InvoiceType {
  SIMPLE
  ACOMPTE
  SOLDE
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum PaymentMethod {
  BANK_TRANSFER
  CARD
  CHECK
  CASH
  OTHER
  SEPA_DEBIT
}

enum EmailDirection {
  INBOUND
  OUTBOUND
}

enum MailFolderRole {
  INBOX
  SENT
  DRAFTS
  TRASH
  JUNK
  ARCHIVE
  CUSTOM
}

/// Compte mail (extensible multi-comptes)
model MailAccount {
  id        String       @id @default(cuid())
  email     String
  label     String?
  isDefault Boolean      @default(true)
  imapHost  String?
  smtpHost  String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  folders   MailFolder[]

  @@index([isDefault])
}

/// Dossier IMAP synchronisé (ou virtuel côté ERP)
model MailFolder {
  id           String         @id @default(cuid())
  accountId    String
  account      MailAccount    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  imapPath     String
  displayName  String
  role         MailFolderRole @default(CUSTOM)
  uidValidity  Int            @default(0)
  highestUid   Int            @default(0)
  unreadCount  Int            @default(0)
  isVirtual    Boolean        @default(false)
  lastSyncedAt DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  messages     EmailMessage[]

  @@unique([accountId, imapPath])
  @@index([accountId, role])
}

/// État de connexion sync (bannière UI)
model MailSyncStatus {
  id          String    @id @default("default")
  connected   Boolean   @default(false)
  idleActive  Boolean   @default(false)
  lastError   String?
  lastSyncAt  DateTime?
  reconnectAt DateTime?
  updatedAt   DateTime  @updatedAt
}

enum UrssafPeriodicity {
  MONTHLY
  QUARTERLY
}

enum UrssafDeclarationStatus {
  DUE
  PAID
  LATE
}

enum ObligationType {
  URSSAF_DECLARATION
  CFE_PAYMENT
  CFE_INITIAL_DECLARATION
  INCOME_TAX_DECLARATION
  ACTIVITY_QUESTIONNAIRE
  ANNUAL_MISC
}

enum ObligationStatus {
  PENDING
  DONE
  LATE
}

enum ServiceUnit {
  HEURE
  JOUR
  FORFAIT
}

enum MilestoneStatus {
  PENDING
  DUE
  INVOICED
  PAID
  OVERDUE
  FAILED
  CANCELLED
}

enum CreditNoteReason {
  REFUND_DEPOSIT
  COMMERCIAL_GESTURE
  AMOUNT_CORRECTION
}

enum RefundMethod {
  BANK_TRANSFER
  DEDUCT_FROM_BALANCE
  OTHER
}

model User {
  id                         String                @id @default(cuid())
  email                      String                @unique
  name                       String?
  passwordHash               String
  /// Secret TOTP actif (base32), chiffré avec ENCRYPTION_KEY. Null = 2FA non activée.
  totpSecretEncrypted        String?
  /// Secret en cours d'enrôlement, activé après vérification d'un premier code.
  totpPendingSecretEncrypted String?
  totpEnabledAt              DateTime?
  /// Dernier pas TOTP accepté : un pas inférieur ou égal est refusé (anti-rejeu).
  totpLastStep               Int?
  /// Échecs consécutifs (mot de passe ou code) venus du tunnel, remis à zéro au succès.
  failedLogins               Int                   @default(0)
  lockedUntil                DateTime?
  /// Dernière lecture de la cloche (« Tout marquer comme lu »), commune à tous les appareils.
  notificationsSeenAt        DateTime?
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime              @updatedAt
  sessions                   Session[]
  recoveryCodes              AdminRecoveryCode[]
  loginChallenges            AdminLoginChallenge[]
  devices                    AdminDevice[]
  pushSubscriptions          PushSubscription[]
}

/// Abonnement aux notifications push d'un appareil (navigateur) : un par appareil, révocable.
model PushSubscription {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// URL du service push du navigateur (unique par appareil et navigateur)
  endpoint      String    @unique
  p256dh        String
  auth          String
  /// Nom affiché (ex. « Chrome sur Android »)
  label         String
  createdAt     DateTime  @default(now())
  lastSuccessAt DateTime?
  lastErrorAt   DateTime?
  lastError     String?

  @@index([userId])
}

/// Code de secours 2FA à usage unique, stocké haché (HMAC-SHA256).
model AdminRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// Étape intermédiaire de connexion : mot de passe validé, code TOTP attendu. id = SHA-256 du jeton du cookie.
model AdminLoginChallenge {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  attempts  Int      @default(0)
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// Appareil admin reconnu (cookie d'appareil haché) : alerte email à la première connexion.
model AdminDevice {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceHash  String
  userAgent   String?
  ipAddress   String?
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@unique([userId, deviceHash])
}

/// Session serveur (cookie httpOnly opaque)
model Session {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  /// Dernière requête authentifiée : session close après 24 h d'inactivité (null : session antérieure)
  lastSeenAt DateTime?
  /// Connexion passée par la double authentification (ou activation de la 2FA) ; seule une session vérifiée est
  /// acceptée par le tunnel (migration 20261222090000)
  mfaVerified Boolean  @default(false)

  @@index([userId])
  @@index([expiresAt])
}

/// Identité émetteur (seedée depuis l'attestation INPI)
model CompanySettings {
  id                        String            @id @default(cuid())
  legalName                 String
  tradeName                 String?
  siren                     String
  siret                     String
  apeCode                   String
  addressLine1              String
  addressLine2              String?
  postalCode                String
  city                      String
  country                   String            @default("FRANCE")
  email                     String?
  phone                     String?
  website                   String?
  vatRegime                 String            @default("FRANCHISE_BASE_293B")
  /// Mention de TVA (seule source, Réglages > Mentions légales). DEFAULT SQL jamais utilisé, gardé sans migration (une
  /// reconstruction de la table sous SQLite) : la ligne unique est créée avec la valeur de seed-company.ts.
  vatMention                String            @default("TVA non applicable, art. 293 B du CGI")
  /// Enveloppe trésorerie / frais (budget perso, pas légal)
  treasuryRateBps           Int               @default(1420)
  /// Enveloppe placements / épargne (budget perso)
  placementRateBps          Int               @default(1000)
  urssafPeriodicity         UrssafPeriodicity @default(MONTHLY)
  /// Jour limite URSSAF (légal AE : 15 du mois suivant) - conservé pour compat
  urssafDeadlineDay         Int               @default(15)
  publicodesRegime          String            @default("AE_BNC_LIBERAL")
  invoicePrefix             String            @default("")
  /// Templates de numérotation : {prefix}, {year}, {counter}
  invoiceNumberTemplate     String            @default("F-{year}-{counter}")
  quoteNumberTemplate       String            @default("D-{year}-{counter}")
  creditNoteNumberTemplate  String            @default("A-{year}-{counter}")
  /// Largeur du compteur (padding), défaut 4 → 0001
  numberCounterWidth        Int               @default(4)
  /// Reprise legacy : JSON { "FACTURE:2026": 7 } = lastValue initial avant incrément
  numberingLegacyStarts     Json?
  /// @deprecated préférer LegalClause - conservé en fallback
  paymentConditions         String            @default("Paiement à réception")
  /// @deprecated préférer LegalClause
  latePenaltiesText         String            @default("En cas de retard de paiement, une pénalité égale à 3 fois le taux d'intérêt légal sera due, ainsi qu'une indemnité forfaitaire de 40 € pour frais de recouvrement.")
  /// Mention obligatoire : conditions d'escompte en cas de paiement anticipé
  earlyPaymentDiscountText  String            @default("Escompte pour paiement anticipé : néant")
  /// @deprecated préférer LegalClause
  legalMentions             String?
  /// @deprecated préférer LegalClause
  suspensionClause          String            @default("En cas de non-paiement d'une échéance, les prestations peuvent être suspendues jusqu'à régularisation.")
  /// Jours après émission avant 1re relance devis
  reminderQuoteDays         Int               @default(7)
  /// Jours après échéance avant 1re relance facture
  reminderInvoiceDays       Int               @default(7)
  /// Abonnement annuel : la date limite pour refuser la reconduction tombe N jours avant le renouvellement (1 = la veille)
  nonRenewalNoticeDays      Int               @default(1)
  /// Abonnement annuel : mois offerts par rapport à 12 mensualités (remise proposée par défaut)
  annualFreeMonths          Int               @default(2)
  /// Mode de la dernière clé Stripe enregistrée (« test » ou « live ») : changement signalé
  stripeKeyMode             String?
  /// Notifications push : dernier événement de la cloche déjà envoyé (pas de doublon)
  pushDispatchedAt          DateTime?
  /// Afficher les montants sur le suivi public client
  publicTrackingShowAmounts Boolean           @default(false)
  /// Invitation à laisser un avis Google : e-mail au passage d'un projet à DONE (une fois par projet)
  /// et bouton dans l'espace client. Sans lien d'avis, rien n'est proposé.
  reviewInviteEnabled       Boolean           @default(true)
  googleReviewUrl           String?           @default("https://g.page/r/Cb8yzZKdc-SEEBM/review/")
  /// URL du portail client (suivi devis / factures)
  clientPortalUrl           String?
  /// Date de création de l'entreprise (INPI) pour délais initiaux
  businessStartDate         DateTime?
  /// Date d'immatriculation au RNE (INPI / open data)
  rneRegistrationDate       DateTime?
  /// Dernière année de revenus déclarée (ex. 2025 = revenus 2025 déclarés en 2026)
  lastIncomeTaxDeclaredYear Int?
  /// Montant CFE par défaut (centimes), saisi à réception de l'avis
  cfeAmountCents            Int               @default(25000)
  /// IBAN du compte pro (affiché sur factures pour virement client)
  bankIban                  String?
  /// BIC / SWIFT
  bankBic                   String?
  /// Titulaire du compte pro
  bankAccountHolder         String?
  /// Nom de la banque (ex. Revolut)
  bankName                  String?
  /// Facture des particuliers (médiation conso)
  b2cActivity               Boolean           @default(false)
  /// Mention médiation consommation (affichée sur le PDF si b2cActivity=true)
  mediationClause           String?
  /// Rappel déclaration revenus : mois (1-12), défaut avril
  incomeTaxReminderMonth    Int               @default(4)
  /// Rappel déclaration revenus : jour, défaut 15
  incomeTaxReminderDay      Int               @default(15)
  /// Liens officiels (JSON) : urssafDeclaration, impotsPro, impotsParticulier
  officialLinks             Json?
  /// Lien fiche entreprise data.inpi.fr
  inpiUrl                   String?
  /// SMTP optionnel (prioritaire sur les variables d'environnement si renseigné)
  smtpHost                  String?
  smtpPort                  Int?
  smtpSecure                Boolean           @default(false)
  /// SSL | STARTTLS | NONE (null = dérivé de smtpSecure)
  smtpEncryption            String?
  smtpUser                  String?
  smtpPassEncrypted         String?
  smtpPassHint              String?
  smtpFrom                  String?
  smtpFromName              String?
  smtpReplyTo               String?
  /// Expéditeur des e-mails automatiques (codes, invitation, accès, alertes), ex. noreply@kouzia.com.
  /// Vide : smtpFrom. Les réponses vont au Reply-To (contact@).
  transactionalFrom         String?
  /// Plafond d'envois (emails / minute)
  emailThrottlePerMinute    Int               @default(30)
  /// Familles d'e-mails automatiques validées d'office (JSON string[]) ; vide : tout passe par « E-mails à valider ».
  /// La mise en demeure n'y figure jamais (toujours validée à la main)
  emailAutoApproveKinds     String            @default("[]")

  /// IMAP (réception). Prioritaire sur IMAP_* du .env si hôte + utilisateur renseignés.
  imapHost                String?
  imapPort                Int?
  imapSecure              Boolean @default(true)
  imapUser                String?
  imapPassEncrypted       String?
  imapPassHint            String?
  imapMailbox             String  @default("INBOX")
  imapPollIntervalMinutes Int     @default(15)

  /// Mapping dossiers IMAP (null = auto-détection Hostinger)
  imapFolderInbox   String?
  imapFolderSent    String?
  imapFolderDrafts  String?
  imapFolderTrash   String?
  imapFolderJunk    String?
  imapFolderArchive String?

  /// Signature email (HTML) insérée dans les nouveaux messages
  emailSignatureHtml        String?
  /// Notifications navigateur pour nouveaux emails
  emailBrowserNotifications Boolean @default(false)

  /// Plafonds pièces jointes IMAP (stockage ERP). Défauts calés sur un mail riche (PDF + photos + video courte).
  attachmentMaxFileMb    Int @default(50)
  attachmentMaxMessageMb Int @default(80)

  /// Identité légale (PDF, emails, portail)
  legalForm             String?
  rcsMention            String?
  vatIntraNumber        String?
  decennaleInsurer      String?
  decennalePolicyNumber String?
  decennaleCoverageZone String?

  /// Charte documents (PDF / emails)
  brandPrimaryColor   String  @default("#fe9a00")
  brandSecondaryColor String  @default("#0b1020")
  brandLogoPath       String?
  pdfFooterText       String?

  /// Revolut Merchant API (encaissement en ligne). Distinct de la Business API bancaire.
  revolutMerchantApiKeyEncrypted String?
  revolutMerchantApiKeyHint      String?
  revolutWebhookSecretEncrypted  String?
  revolutWebhookSecretHint       String?
  /// sandbox | production
  revolutMerchantMode            String  @default("sandbox")

  /// Échéancier d'acomptes (bps, 10000 = 100 %) : acompte + solde
  depositCount           Int     @default(2)
  depositPercent1Bps     Int     @default(3000)
  depositPercent2Bps     Int     @default(7000)
  depositPercent3Bps     Int     @default(0)
  /// Paiement en 3 fois : acompte, 2e acompte (étape de projet), solde. Somme = 10000.
  split3Percent1Bps      Int     @default(3000)
  split3Percent2Bps      Int     @default(4000)
  split3Percent3Bps      Int     @default(3000)
  /// Total minimal (centimes) pour proposer le 3 fois ; en dessous, l'offre retombe sur 2 fois.
  split3MinTotalCents    Int     @default(50000)
  /// Paiement en plusieurs fois (mode ONE_OFF) : jours entre deux échéances, la 1re étant due à la signature.
  installmentIntervalDays Int    @default(30)
  /// Nouveaux devis : proposer au client le choix entre 2 et 3 fois.
  paymentChoiceDefault   Boolean @default(false)
  /// Déclencheur imprimé pour le 2e acompte du 3 fois.
  split3Step2TriggerText String  @default("À la validation de l'étape définie dans le suivi de projet")
  /// Jours avant échéance où le bouton de paiement Revolut est créé / activé
  paymentButtonLeadDays  Int     @default(7)
  /// Position du jalon 2 sur la durée du projet (5000 = 50 %)
  projectMilestoneMidBps Int     @default(5000)

  /// Rappels d'acomptes (délais en jours, activables)
  reminderDepositMinus7Days    Int     @default(7)
  reminderDepositMinus1Days    Int     @default(1)
  reminderDepositPlus3Days     Int     @default(3)
  reminderDepositPlus10Days    Int     @default(10)
  reminderDepositMinus7Enabled Boolean @default(true)
  reminderDepositMinus1Enabled Boolean @default(true)
  reminderDepositPlus3Enabled  Boolean @default(true)
  reminderDepositPlus10Enabled Boolean @default(true)

  /// Google Calendar (OAuth) : sync événements obligations vers Agenda
  googleCalendarRefreshTokenEncrypted String?
  googleCalendarRefreshTokenHint      String?
  googleCalendarConnectedEmail        String?
  googleCalendarEnabled               Boolean   @default(false)
  /// Google a refusé le jeton (invalid_grant) : plus de tentative jusqu'à la reconnexion
  googleCalendarReauthRequiredAt      DateTime?
  /// CGV publiées sur le site : acceptation exigée à la signature, lien et version sur les devis
  cgvPublished                        Boolean   @default(false)
  cgvUrl                              String?   @default("https://kouzia.com/cgv")
  /// Version en vigueur (date de mise en ligne, ex. 2026-11-04)
  cgvVersion                          String?
  /// Libellé de la case « exécution avant la fin du délai de rétractation » (clients particuliers)
  withdrawalExpressRequestText        String    @default("Je demande que la prestation commence avant la fin du délai de rétractation de 14 jours. Si je me rétracte ensuite, je paierai un montant proportionnel à ce qui aura été fourni jusqu'à ma rétractation. Si la prestation est entièrement exécutée avant la fin de ce délai, je perds mon droit de rétractation.")
  /// Destinataire emails de rappel obligations (hors ClientEmailEvent)
  obligationReminderEmail             String    @default("kouziaeffa.pro@gmail.com")
  obligationEmailRemindersEnabled     Boolean   @default(true)

  /// Modules ERP (affichage nav + pages). Banque off par défaut (Revolut Pro sans API).
  moduleBankEnabled          Boolean @default(false)
  moduleSubscriptionsEnabled Boolean @default(true)
  /// @deprecated remplacé par moduleStripeEnabled. Conservé en base (SQLite).
  moduleMerchantApiEnabled   Boolean @default(false)

  /// Stripe : encaissement en ligne, catalogue et abonnements.
  moduleStripeEnabled          Boolean @default(false)
  /// Moyens proposés sur un lien Stripe, dans cet ordre : prélèvement SEPA, virement Stripe (toujours), carte jusqu'au seuil
  paymentSepaEnabled           Boolean @default(true)
  paymentCardEnabled           Boolean @default(true)
  /// Carte proposée seulement jusqu'à ce montant (centimes) ; au-delà, SEPA et virement
  paymentCardMaxCents          Int     @default(30000)
  stripeSecretKeyEncrypted     String?
  stripeSecretKeyHint          String?
  stripeWebhookSecretEncrypted String?
  stripeWebhookSecretHint      String?

  /// Espace Site : jeton GitHub (fine-grained PAT) qui publie le contenu de kouzia.com. Jamais renvoyé.
  githubTokenEncrypted String?
  githubTokenHint      String?
  /// Lue dans l'en-tête github-authentication-token-expiration au test de connexion (rappel à J-30).
  githubTokenExpiresAt DateTime?
  /// Dernier test réussi du jeton : distingue « jamais testé » de « testé, sans date d'expiration »
  githubTokenCheckedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Journal des modifications de Paramètres (jamais de valeurs secrètes)
model SettingsAuditLog {
  id        String   @id @default(cuid())
  userId    String?
  userEmail String?
  tab       String
  field     String
  createdAt DateTime @default(now())

  @@index([tab, createdAt])
  @@index([createdAt])
}

enum LegalClauseKind {
  VAT
  PAYMENT
  PENALTY
  SUSPENSION
  CUSTOM
  /// Imprimées dans l'encadré d'abonnement du devis, selon la périodicité
  SUBSCRIPTION_MONTHLY
  SUBSCRIPTION_ANNUAL
  SUBSCRIPTION_QUARTERLY
  /// Droit de rétractation et formulaire type : devis des clients particuliers
  WITHDRAWAL
  /// Phrase sous les abonnements d'un devis : date de prélèvement à changer par un refus motivé
  SUBSCRIPTION_BILLING_DATE
  /// Abonnement avec durée d'engagement (offre tout compris) : imprimée à la place de la clause de périodicité
  SUBSCRIPTION_COMMITMENT
  /// Cession du site au client (rachat, R2) : imprimée seulement sur un devis de rachat
  BUYOUT_TRANSFER
}

/// Clients auxquels une clause s'imprime (type du client du document)
/// ASSOCIATION et NON_PROFESSIONAL (associations et particuliers) ajoutés le 26/10/2026 : aucune migration, une énumération
/// est un TEXT sans contrainte sous SQLite (prisma migrate diff vide).
enum LegalClauseAudience {
  ALL
  B2B
  B2C
  ASSOCIATION
  NON_PROFESSIONAL
}

/// Conditions / mentions légales gérables (comme le catalogue prestations)
model LegalClause {
  id        String              @id @default(cuid())
  kind      LegalClauseKind     @default(CUSTOM)
  title     String
  body      String
  /// Clause légale obligatoire (non supprimable)
  required  Boolean             @default(false)
  active    Boolean             @default(true)
  /// ALL : tous les documents ; B2B ou B2C : seulement pour ce type de client
  audience  LegalClauseAudience @default(ALL)
  position  Int                 @default(0)
  /// Supprimée par l'admin (migration 20261219090000) : gardée pour ne jamais recréer une clause par défaut ; toujours inactive
  deletedAt DateTime?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([active, position])
}

/// Obligation administrative générique (URSSAF, CFE, impôts, etc.)
model Obligation {
  id                        String                  @id @default(cuid())
  type                      ObligationType
  /// Clé période : "2026-07", "2026-Q2", "2026", "ONCE"
  period                    String
  dueDate                   DateTime
  status                    ObligationStatus        @default(PENDING)
  completedAt               DateTime?
  /// Montant dû en centimes (nullable si inconnu)
  amountCents               Int?
  notes                     String?
  label                     String
  /// Justificatif PDF téléversé (chemin relatif data/uploads/…)
  attachmentPath            String?
  attachmentName            String?
  attachmentMime            String?
  /// Id événement Google Calendar (échéance / clôture)
  googleCalendarEventId     String?
  /// Id événement Google Calendar (ouverture de la fenêtre déclarative)
  googleCalendarOpenEventId String?
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt
  reminderLogs              ObligationReminderLog[]

  @@unique([type, period])
  @@index([status])
  @@index([dueDate])
  @@index([type])
  @@index([completedAt])
}

/// Idempotence des emails de rappel obligations (J-7, J-3, J-1, jour J)
model ObligationReminderLog {
  id           String     @id @default(cuid())
  obligationId String
  obligation   Obligation @relation(fields: [obligationId], references: [id], onDelete: Cascade)
  /// j7 | j3 | j1 | j0
  stage        String
  sentAt       DateTime   @default(now())

  @@unique([obligationId, stage])
  @@index([sentAt])
}

/// Checklist démarches post-création (une seule ligne)
model StartupChecklist {
  id                    String   @id @default(cuid())
  urssafAccount         Boolean  @default(false)
  impotsProAccount      Boolean  @default(false)
  activityQuestionnaire Boolean  @default(false)
  cfeInitialDeclaration Boolean  @default(false)
  rcpInsurance          Boolean  @default(false)
  mediationChecked      Boolean  @default(false)
  dedicatedBankAccount  Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

/// Compteur nommé (ex. name=client pour CLI-0001) - hors séries documents
model NamedCounter {
  name      String @id
  lastValue Int    @default(0)
}

/// Séries légales de numérotation documents (art. 242 nonies CGI)
enum NumberingDocumentType {
  FACTURE
  DEVIS
  AVOIR
}

/// Compteur atomique par (type document, exercice)
model Counter {
  id           String                @id @default(cuid())
  documentType NumberingDocumentType
  year         Int
  lastValue    Int                   @default(0)

  @@unique([documentType, year])
  @@index([documentType])
}

/// Historique des déclarations / virements URSSAF (période M ou trimestre)
model UrssafDeclaration {
  id             String                  @id @default(cuid())
  /// Clé unique période : "2026-07" (mensuel) ou "2026-Q2" (trimestriel)
  periodKey      String                  @unique
  periodicity    UrssafPeriodicity
  periodStart    DateTime
  periodEnd      DateTime
  deadline       DateTime
  /// CA encaissé de la période (centimes)
  encaisseCents  Int
  /// Montant dû calculé Publicodes (centimes)
  amountDueCents Int
  status         UrssafDeclarationStatus @default(DUE)
  paidAt         DateTime?
  paymentRef     String?
  notes          String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@index([status])
  @@index([deadline])
}

model Client {
  id                    String                 @id @default(cuid())
  siteReviews           SiteReview[]
  /// Numéro public CLI-0001
  clientNumber          String?                @unique
  type                  ClientType
  /// Jour de prélèvement par défaut de ses abonnements (1 à 28) ; null = le 1er. Chaque abonnement garde le sien.
  billingDay            Int?
  displayName           String
  firstName             String?
  lastName              String?
  companyName           String?
  emailEncrypted        String?
  /// HMAC-SHA256 de l'email normalisé (lookup messagerie sans decrypt)
  emailHash             String?                @unique
  phoneEncrypted        String?
  siretEncrypted        String?
  sirenEncrypted        String?
  /// Code NAF/APE (open data)
  apeCode               String?
  /// Date de dernière vérification via recherche-entreprises
  companyVerifiedAt     DateTime?
  addressLine1          String?
  addressLine2          String?
  postalCode            String?
  city                  String?
  country               String                 @default("FRANCE")
  /// Code INSEE commune (BAN)
  addressCityCode       String?
  addressLat            Float?
  addressLon            Float?
  /// Ancien champ « Notes internes », en clair : lecture seule, repris en tête du bloc-notes (reprise bloc-notes)
  notes                 String?
  /// Bloc-notes unique de la fiche, chiffré au repos ; null = jamais écrit
  notepadEncrypted      String?
  /// Version du bloc-notes : +1 à chaque enregistrement ; 0 = jamais écrit ni repris
  notepadVersion        Int                    @default(0)
  notepadUpdatedAt      DateTime?
  /// Enregistrement concurrent (autre appareil) : les deux textes gardés, bandeau « à relire » jusqu'au suivant
  notepadConflictAt     DateTime?
  /// Ancien format, en lecture seule depuis la reprise (repris dans needsDetails) : JSON [{ id, label, done }]
  needs                 String                 @default("[]")
  /// « Précisions » des besoins, texte libre ; null = jamais écrit ni repris
  needsDetails          String?
  /// Date à laquelle le client a complété son onboarding (via invitation)
  onboardingCompletedAt DateTime?
  /// Date du dernier envoi de l'e-mail d'accès à l'espace client
  accessEmailSentAt     DateTime?
  /// Première connexion à l'espace client par code e-mail : l'adresse est confirmée
  emailVerifiedAt       DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  portalCodes           PortalCode[]
  portalSessions        PortalSession[]
  invoices              Invoice[]
  emailThreads          EmailThread[]
  emailEvents           ClientEmailEvent[]
  subscriptions         Subscription[]
  renewals              ClientRenewal[]
  onboardingAsExisting  OnboardingInvitation[] @relation("OnboardingExisting")
  onboardingAsCreated   OnboardingInvitation[] @relation("OnboardingCreated")

  testimonials           ClientTestimonial[]
  projects               ClientProject[]
  appointmentNotes       ClientNote[]
  contacts               ClientContact[]
  serviceNeeds           ClientServiceNeed[]
  portalSeen             ClientPortalSeen[]
  softwareRequests       SoftwareRequest[]
  siteProjects           SiteProject[]
  /// Fiche préparée hors ligne : UUID de l'appareil ; un renvoi rend la même fiche (idempotence)
  clientRequestId        String?             @unique
  /// Identifiant Customer Stripe (cus_…)
  stripeCustomerId       String?             @unique
  /// Mode Stripe de stripeCustomerId : true = live, false = test
  stripeCustomerLivemode Boolean?

  @@index([displayName])
  @@index([type])
}

/// Code à 6 chiffres envoyé par e-mail : connexion à l'espace client (LOGIN) ou signature d'un devis (SIGN).
model PortalCode {
  id        String    @id @default(cuid())
  clientId  String
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// LOGIN | SIGN
  purpose   String
  /// Devis concerné (SIGN)
  quoteId   String?
  /// HMAC-SHA256 du code : jamais stocké en clair
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([clientId, purpose, createdAt])
}

/// Appareil reconnu après un code de connexion (cookie httpOnly, 15 jours).
model PortalSession {
  id         String    @id @default(cuid())
  clientId   String
  client     Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// SHA-256 du jeton : le jeton clair n'existe que dans le cookie du navigateur
  tokenHash  String    @unique
  /// SHA-256 de l'identifiant d'appareil (cookie longue durée) : repère un nouvel appareil
  deviceHash String
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  @@index([clientId])
}

/// Avancement d'un projet client, affiché dans l'espace client (/suivi) quand visible.
/// Type d'un projet client, affiché dans l'espace client (facultatif).
enum ClientProjectKind {
  SITE
  LOGICIEL
  MAINTENANCE
  AUTRE
}

model ClientProject {
  id                 String             @id @default(cuid())
  clientId           String
  client             Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name               String
  /// 0 à 100
  progress           Int                @default(0)
  /// JSON [{ label, status: done|current|todo, date?: YYYY-MM-DD }]
  steps              String             @default("[]")
  /// JSON [{ label, url (https) }]
  links              String             @default("[]")
  /// JSON [{ label, done, note? }]
  checklist          String             @default("[]")
  visibleOnPortal    Boolean            @default(true)
  position           Int                @default(0)
  /// Devis d'origine : le projet naît de la facture d'acompte (ou totale) de ce devis.
  quoteId            String?            @unique
  quote              Invoice?           @relation("QuoteProject", fields: [quoteId], references: [id], onDelete: SetNull)
  /// PLANNED (acompte facturé, en attente de paiement) | ACTIVE (démarré) | DONE
  status             String             @default("ACTIVE")
  startedAt          DateTime?
  /// Type de projet (site, logiciel, maintenance, autre) ; null tant qu'il n'est pas renseigné.
  kind               ClientProjectKind?
  /// Invitation à laisser un avis envoyée (une seule fois par projet, au passage à DONE).
  reviewInviteSentAt DateTime?
  testimonial        SiteReview?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([clientId, position])
}

/// Contact d'un client (particulier compris). Le contact principal reste synchronisé avec Client.email, phone,
/// firstName et lastName, qui gardent la référence (espace client, /suivi, API publique) ; un seul principal par
/// client, garanti par l'API dans une transaction.
model ClientContact {
  id             String   @id @default(cuid())
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// Prénom et nom en clair, comme Client.firstName et lastName (recherche)
  firstName      String?
  lastName       String?
  /// Fonction ou libellé (« Gérante », « Contact principal » pour un contact sans nom)
  role           String?
  emailEncrypted String?
  /// Non unique : deux clients peuvent partager une adresse de standard
  emailHash      String?
  phoneEncrypted String?
  isPrimary      Boolean  @default(false)
  position       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([clientId, position])
  @@index([emailHash])
}

/// Demande d'utilisation d'un logiciel (Tracebay) déposée depuis le site. Base légale : mesures précontractuelles
/// (art. 6.1.b RGPD), mention d'information affichée (noticeVersion). Non convertie : supprimée 3 ans après updatedAt.
model SoftwareRequest {
  id                   String    @id @default(cuid())
  /// TRACEBAY
  software             String
  /// PENDING | CONVERTED | DECLINED
  status               String    @default("PENDING")
  companyName          String
  contactNameEncrypted String
  emailEncrypted       String
  emailHash            String
  phoneEncrypted       String?
  /// Version souhaitée : SERVER | PORTABLE | UNSURE
  edition              String
  /// Tranche : 1 | 2_5 | 6_20 | 20_PLUS
  seats                String
  need                 String
  /// 3_MONTHS | 6_MONTHS | 12_MONTHS | UNSURE
  duration             String
  /// 12 caractères hexadécimaux du SHA-256 de la mention d'information affichée par le site
  noticeVersion        String
  /// Client issu de la demande (conversion) : lien lu plus tard par le hub pour la clé de licence.
  clientId             String?
  client               Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  convertedAt          DateTime?
  declinedAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([emailHash])
  @@index([clientId])
  @@index([software, status, createdAt])
}

/// Dernière ouverture d'une rubrique de /suivi par le client (pastilles « non vu »). Une ligne par rubrique.
model ClientPortalSeen {
  clientId String
  client   Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// projects | documents | payments
  section  String
  seenAt   DateTime

  @@id([clientId, section])
}

/// Besoin d'un client : une prestation du catalogue. Une prestation liée ne se supprime pas (elle s'archive).
model ClientServiceNeed {
  clientId  String
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  serviceId String
  service   Service   @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  /// Case « traité » cochée à cette date ; null = en attente
  doneAt    DateTime?
  createdAt DateTime  @default(now())

  @@id([clientId, serviceId])
  @@index([serviceId])
}

/// Note de rendez-vous (journal de la fiche client), saisie en ligne ou préparée hors ligne.
model ClientNote {
  id              String   @id @default(cuid())
  clientId        String
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// Ancienne note de rendez-vous : reprise dans le bloc-notes ; celle envoyée par un ancien appareil y est ajoutée
  /// Texte de la note, chiffré au repos comme les autres données personnelles
  bodyEncrypted   String
  /// UUID de l'appareil : un renvoi rend la même note (idempotence)
  clientRequestId String   @unique
  /// Date de saisie (hors ligne : date de préparation sur l'appareil)
  preparedAt      DateTime
  createdAt       DateTime @default(now())

  @@index([clientId, preparedAt])
}

/// Journal des emails sortants vers un client (suivi portail /admin)
model ClientEmailEvent {
  id                 String   @id @default(cuid())
  clientId           String
  client             Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  kind               String
  subject            String
  /// Ancienne colonne en clair : "" pour toute ligne écrite ou recopiée depuis le chiffrement
  toAddress          String
  /// Adresse du destinataire, chiffrée (lecture : toAddressEncrypted, à défaut toAddress)
  toAddressEncrypted String?
  documentId         String?
  documentNumber     String?
  success            Boolean  @default(true)
  errorMessage       String?
  sentAt             DateTime @default(now())
  outboxId           String?
  threadId           String?

  @@index([clientId, sentAt])
  @@index([documentId])
  @@index([outboxId])
  @@index([threadId])
}

/// Invitation envoyée à un prospect/client pour qu'il remplisse sa fiche lui-même.
/// existingClientId null = création d'un nouveau client à la soumission ;
/// existingClientId renseigné = mise à jour du client existant.
model OnboardingInvitation {
  id               String    @id @default(cuid())
  /// Email de destination de l'invitation (ancienne colonne en clair : "" depuis le chiffrement)
  email            String
  /// Email de destination, chiffré (lecture : emailEncrypted, à défaut email)
  emailEncrypted   String?
  /// Token secret du lien /onboarding/:token (legacy hex) ou jti HMAC
  token            String    @unique
  /// Identifiant unique pour idempotence HMAC (UUID)
  jti              String?   @unique
  /// Date d'expiration du token
  expiresAt        DateTime
  /// Date de soumission du formulaire (null = pas encore rempli)
  usedAt           DateTime?
  /// Client existant à mettre à jour (null = nouveau client à créer)
  existingClient   Client?   @relation("OnboardingExisting", fields: [existingClientId], references: [id], onDelete: SetNull)
  existingClientId String?
  /// Client créé à la soumission (quand existingClient est null)
  createdClient    Client?   @relation("OnboardingCreated", fields: [createdClientId], references: [id], onDelete: SetNull)
  createdClientId  String?
  createdAt        DateTime  @default(now())

  @@index([email])
}

model Service {
  id                String            @id @default(cuid())
  name              String
  description       String?
  unitPriceCents    Int
  unit              ServiceUnit       @default(FORFAIT)
  active            Boolean           @default(true)
  /// Prestation d'abonnement mensuel (utilisable sur devis/facture)
  isSubscription    Boolean           @default(false)
  /// Jour de facturation par défaut (1-28) si isSubscription
  defaultBillingDay Int               @default(1)
  /// Identifiant Product Stripe (prod_…)
  stripeProductId   String?
  /// Identifiant Price Stripe (price_…) : une prestation ERP = un prix
  stripePriceId     String?           @unique
  /// Mode Stripe des identifiants ci-dessus : true = live, false = test
  stripeLivemode    Boolean?
  /// MONTH | YEAR | null (prestation ponctuelle)
  billingInterval   String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  subscriptions     Subscription[]
  invoiceLines      InvoiceLine[]
  /// Rubrique du catalogue : SITE | LOGICIEL | OPTION ; null = « Autres » (packs et abonnements : rubrique propre)
  category          String?
  /// Pack : prix d'achat en paiement unique (unitPriceCents) ; son contenu est dans packItems. Jamais lié à Stripe.
  isPack            Boolean           @default(false)
  /// Pack : prix de référence annuel en paiement récurrent (annuel, / 4 ou / 12). Null = pas vendable en récurrent.
  annualPriceCents  Int?
  packItems         ServicePackItem[] @relation("PackItems")
  /// Packs qui contiennent cette prestation (elle s'archive au lieu d'être supprimée)
  inPacks           ServicePackItem[] @relation("PackComponent")
  /// Clients qui ont noté cette prestation comme besoin (elle s'archive au lieu d'être supprimée)
  clientNeeds       ClientServiceNeed[]
  /// Offre d'abonnement : prestation ponctuelle de rachat du site (prix du catalogue) ; null = pas de rachat
  buyoutServiceId   String?

  @@index([active])
  @@index([name])
  @@index([stripeProductId])
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  ENDED
}

enum SubscriptionCollectionMethod {
  MANUAL_TRANSFER
  SEPA_DEBIT
  /// Encaissement géré par Stripe Billing (webhooks invoice.*)
  STRIPE
}

model Subscription {
  id                      String                       @id @default(cuid())
  clientId                String
  client                  Client                       @relation(fields: [clientId], references: [id])
  serviceId               String
  service                 Service                      @relation(fields: [serviceId], references: [id])
  /// Libellé de la facture récurrente (ex. "Maintenance site web : mensuel")
  label                   String
  /// Montant HT par échéance (centimes). Franchise TVA → HT = TTC.
  amountCents             Int
  /// Jour du mois de facturation (1-28 pour éviter débordement)
  billingDay              Int
  startDate               DateTime
  /// null = actif indéfiniment
  endDate                 DateTime?
  /// Durée d'engagement en mois (offre tout compris : 36) ; null = sans engagement
  commitmentMonths        Int?
  /// Fin de l'engagement = départ du contrat + commitmentMonths ; avant cette date, résiliation sur demande traitée par l'admin
  commitmentEndsAt        DateTime?
  /// Remise du devis signé (R1) : PERCENT (points de base) | FIXED (centimes par échéance), sur discountPeriods échéances ;
  /// discountPeriodsBilled : échéances déjà facturées remisées. Ensuite, tarif plein (amountCents).
  discountKind            String?
  discountValue           Int?
  discountPeriods         Int?
  discountPeriodsBilled   Int                          @default(0)
  status                  SubscriptionStatus           @default(ACTIVE)
  collectionMethod        SubscriptionCollectionMethod @default(MANUAL_TRANSFER)
  /// Identifiant Subscription Stripe (sub_…)
  stripeSubscriptionId    String?                      @unique
  /// Mode Stripe de stripeSubscriptionId : true = live, false = test
  stripeLivemode          Boolean?
  /// MONTH | YEAR (copie du prix Stripe)
  billingInterval         String?
  /// Prochaine date d'émission de facture
  nextInvoiceAt           DateTime
  /// Dernière facture générée par cet abonnement
  lastInvoiceId           String?
  /// Échéance (nextInvoiceAt) pour laquelle le rappel J-30 de renouvellement annuel est parti
  renewalReminderSentFor  DateTime?
  /// Échéance (nextInvoiceAt) pour laquelle l'avis de 1re échéance est parti (marqueur propre, distinct du précédent)
  firstChargeNoticeSentFor DateTime?
  /// Changement d'état venu de Stripe (ENDED | PAUSED | ACTIVE) : résiliation, impayés ou pause faits côté Stripe
  stripeStatusChange      String?
  stripeStatusChangedAt   DateTime?
  /// État brut de l'abonnement Stripe (active, past_due, unpaid, canceled…) : badges « en retard », « impayé »
  stripeStatus            String?
  /// Résiliation programmée dans Stripe (cancel_at_period_end) : date de fin ; null si aucune
  stripeCancelAt          DateTime?
  /// Dernière vérification de la carte par défaut (expiration), une fois par mois
  cardCheckedAt           DateTime?
  /// Carte pour laquelle l'avis d'expiration est parti : « pm_…:AAAA-MM »
  cardExpiryNoticeFor     String?
  /// Demande de résiliation faite depuis /suivi (abonnement par virement) : l'admin clôture à la main
  cancellationRequestedAt DateTime?
  /// Jeton court (22 caractères) des liens d'e-mail /api/public/manage et /api/public/card
  publicToken             String?                      @unique
  /// Lien de mise en place du prélèvement Stripe envoyé au client (un seul envoi automatique)
  setupLinkSentAt         DateTime?
  /// Moyen enregistré dans Stripe (sepa_debit | card) et ses 4 derniers chiffres ; jamais l'IBAN ni le numéro complet
  paymentMethodType       String?
  paymentMethodLast4      String?
  /// Rachat : date du transfert du site au client (suivi, hors ERP)
  transferredAt           DateTime?
  invoices                Invoice[]
  sourceLines             InvoiceLine[]                @relation("SubscriptionLines")
  /// Lignes de devis d'avenant qui révisent cet abonnement
  revisionLines           InvoiceLine[]                @relation("SubscriptionRevisions")
  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt

  @@index([status])
  @@index([nextInvoiceAt])
  @@index([clientId])
}

model Invoice {
  id                           String                 @id @default(cuid())
  siteReviews                  SiteReview[]
  /// Numéro légal (documentNumber) : null en brouillon, unique et immuable une fois émis
  number                       String?                @unique
  documentType                 InvoiceDocumentType    @default(INVOICE)
  /// SIMPLE | ACOMPTE | SOLDE (chaque facture reste autonome)
  invoiceType                  InvoiceType            @default(SIMPLE)
  status                       InvoiceStatus          @default(DRAFT)
  /// Statut métier devis (null pour factures / avoirs)
  quoteStatus                  QuoteStatus?
  /// Décision du client sur un devis : horodatage, motif de refus, nom du signataire
  quoteDecidedAt               DateTime?
  quoteRejectReason            String?
  /// Nom saisi lors d'une acceptation en ligne (vaut bon pour accord)
  quoteSignerName              String?
  clientId                     String
  client                       Client                 @relation(fields: [clientId], references: [id])
  clientSnapshot               Json?
  /// Devis : clauses légales retenues à l'émission (kind, title, body, audience, position), variables non remplies.
  /// null : brouillon, ou devis émis avant la migration 20261205090000 (clauses actives au rendu).
  legalClausesSnapshot         Json?
  /// Devis : réglages d'échéancier figés à l'émission (JSON des champs de PlanSettings). null : brouillon, ou devis
  /// émis avant la migration 20261214090000 (réglages actuels).
  paymentScheduleSnapshot      String?
  issueDate                    DateTime?
  /// Date de réalisation de la prestation (mention obligatoire, distincte de l'émission)
  serviceDate                  DateTime?
  /// Référence du bon de commande de l'acheteur, quand il en fournit un
  purchaseOrderRef             String?
  dueDate                      DateTime?
  validUntil                   DateTime?
  sequenceYear                 Int?
  sequenceNumber               Int?
  currency                     String                 @default("EUR")
  subtotalCents                Int                    @default(0)
  totalCents                   Int                    @default(0)
  /// NONE | PERCENT (discountValue en bps, 1000 = 10 %) | FIXED (discountValue en centimes)
  discountType                 String                 @default("NONE")
  discountValue                Int                    @default(0)
  /// Devis récurrent (R1, 26/10/2026) : remise sur les premières échéances, une seule par devis. PERCENT | FIXED, null = aucune
  recurringDiscountKind        String?
  /// PERCENT : points de base (3000 = 30 %) ; FIXED : centimes par échéance
  recurringDiscountValue       Int?
  /// Durée depuis la 1re échéance, en mois (multiple de la période, au plus l'engagement) ; null = tout l'engagement
  recurringDiscountMonths      Int?
  /// Case « Remise d'ouverture » : 30 % sur 12 mois, engagement de 36 mois seulement, mention sur le devis
  openingDiscount              Boolean                @default(false)
  /// Code promo appliqué (R3) : remplit la remise ci-dessus, figée à l'émission ; exclusif des autres remises
  promoCodeId                  String?
  promoCode                    PromoCode?             @relation(fields: [promoCodeId], references: [id], onDelete: Restrict)
  /// Devis à propositions (P1) : proposition retenue, remplie à la signature ; null sans proposition ou avant signature
  selectedOptionId             String?
  selectedOption               QuoteOption?           @relation("SelectedOption", fields: [selectedOptionId], references: [id], onDelete: Restrict)
  /// Devis à propositions : 2 au plus, chacune complète ; vide pour un devis simple
  options                      QuoteOption[]          @relation("QuoteOptions")
  /// Total du marché (devis) figé à l'émission d'un acompte/solde
  marketTotalCents             Int?
  /// Devis : base de l'acompte et de l'échéancier (partie ponctuelle, remise répartie), figée à
  /// l'émission. null = devis émis avant la fonction : le total sert de base.
  depositBaseCents             Int?
  notes                        String?
  paymentTerms                 String?                @default("Paiement à réception")
  /// Facture d'origine pour un avoir (originalInvoiceId)
  creditedInvoiceId            String?
  creditedInvoice              Invoice?               @relation("CreditNotes", fields: [creditedInvoiceId], references: [id])
  creditNotes                  Invoice[]              @relation("CreditNotes")
  /// Motif métier de l'avoir (uniquement CREDIT_NOTE)
  creditReason                 CreditNoteReason?
  creditReasonDetail           String?
  refundMethod                 RefundMethod?
  /// Confirmation CGV : acompte remboursable (null si non applicable)
  cgvDepositRefundable         Boolean?
  /// Devis : formules proposées, ONE | TWO | THREE | CHOICE, NONE sans partie ponctuelle (null = échéancier historique). Figée à l'émission.
  paymentPlanOffer             String?
  /// Devis accepté : formule retenue, ONE | TWO | THREE.
  paymentPlan                  String?
  /// Devis : mode de facturation de tout le document, ONE_OFF (paiement unique, parts égales datées) ou RECURRING
  /// (un abonnement, frais de mise en service possibles). Null = devis antérieur : règles par ligne.
  billingMode                  String?
  /// Checklist suivi post-avoir (JSON)
  creditFollowUp               Json?
  /// Pivot marché : devis commun (nullable si facture hors marché)
  quoteId                      String?
  quote                        Invoice?               @relation("MarketInvoices", fields: [quoteId], references: [id])
  marketInvoices               Invoice[]              @relation("MarketInvoices")
  /// @deprecated préférer quoteId - conservé pour compat conversions
  sourceQuoteId                String?
  sourceQuote                  Invoice?               @relation("QuoteConversions", fields: [sourceQuoteId], references: [id])
  convertedInvoices            Invoice[]              @relation("QuoteConversions")
  /// Jalon d'origine (FK côté facture, sync avec PaymentMilestone.invoiceId)
  milestoneId                  String?                @unique
  sourceMilestone              PaymentMilestone?      @relation("MilestoneInvoice", fields: [milestoneId], references: [id])
  /// Abonnement d'origine (null pour les factures ponctuelles)
  subscriptionId               String?
  subscription                 Subscription?          @relation(fields: [subscriptionId], references: [id])
  lines                        InvoiceLine[]
  payments                     Payment[]
  bankTransactions             BankTransaction[]
  milestones                   PaymentMilestone[]     @relation("QuoteMilestones")
  lastReminderAt               DateTime?
  reminderCount                Int                    @default(0)
  nextReminderAt               DateTime?
  issuedAt                     DateTime?
  /// @deprecated Revolut Merchant. Conservé en base (SQLite).
  revolutOrderId               String?
  /// Lien ERP permanent /api/public/pay/… (ou URL collée à la main)
  checkoutUrl                  String?
  /// Prélèvement SEPA (ou virement Stripe) lancé, résultat attendu : posé par payment_intent.processing, effacé à l'issue
  paymentProcessingAt          DateTime?
  paymentProcessingMethod      String?
  /// Identifiant Invoice Stripe (in_…) : une échéance Billing = une facture ERP
  stripeInvoiceId              String?                @unique
  /// Facture ou avoir émis : PDF archivé à l'émission (data/uploads), servi tel quel ensuite
  pdfPath                      String?
  /// Empreinte SHA-256 du PDF archivé
  pdfSha256                    String?
  pdfArchivedAt                DateTime?
  /// Version lisible (JSON, contrat B du site) figée avec le PDF archivé ; {"unavailable":…} si elle ne peut pas l'être
  readableSnapshot             String?
  /// Devis de rachat (et sa facture) : abonnement racheté
  buysOutSubscriptionId        String?
  /// Devis de rachat : fin de la période en cours figée à sa création (signature refusée si elle a changé)
  buyoutPeriodEndsAt           DateTime?
  /// Facture Stripe : dernière tentative (attempt_count) pour laquelle l'e-mail d'échec est parti
  stripeFailureNotifiedAttempt Int?
  /// Facture Stripe payée après un échec : e-mail de régularisation envoyé
  stripeRecoveryNotifiedAt     DateTime?
  /// Facture Stripe marquée non recouvrable dans Stripe (reste émise et impayée dans l'ERP)
  stripeUncollectibleAt        DateTime?
  /// Facture Stripe : confirmation de paiement (3DS) demandée au client, e-mail envoyé à cette date
  stripeActionRequiredAt       DateTime?
  /// Rappels de confirmation déjà envoyés (J+3, J+5, J+7)
  stripeActionReminderCount    Int                    @default(0)
  /// Page Stripe de la facture où confirmer le paiement (hosted_invoice_url)
  stripeActionUrl              String?
  createdAt                    DateTime               @default(now())
  updatedAt                    DateTime               @updatedAt
  quoteAcceptanceAudits        QuoteAcceptanceAudit[]
  project                      ClientProject?         @relation("QuoteProject")
  /// Brouillon préparé hors ligne : UUID de l'appareil ; un renvoi rend le même document (idempotence)
  clientRequestId              String?                @unique
  /// Préparé hors ligne, à relire : motif court (« client modifié », « prix changé »), effacé à la relecture ou à l'émission
  offlineReviewReason          String?

  @@unique([sequenceYear, sequenceNumber, documentType])
  @@index([status])
  @@index([clientId])
  @@index([issueDate])
  @@index([documentType])
  @@index([invoiceType])
  @@index([quoteId])
  @@index([quoteStatus])
  @@index([nextReminderAt])
  @@index([subscriptionId])
  @@index([promoCodeId])
  @@index([buysOutSubscriptionId])
  @@index([documentType, status])
  @@index([documentType, quoteStatus])
  @@index([clientId, documentType])
  @@index([revolutOrderId])
}

model PaymentMilestone {
  id               String                @id @default(cuid())
  quoteId          String
  quote            Invoice               @relation("QuoteMilestones", fields: [quoteId], references: [id], onDelete: Cascade)
  position         Int
  label            String
  percentBps       Int
  amountCents      Int
  triggerText      String
  status           MilestoneStatus       @default(PENDING)
  /// Date d'échéance du règlement (signature devis ou jalon projet)
  dueDate          DateTime?
  /// Revolut Merchant (encaissement en ligne)
  revolutOrderId   String?
  revolutPaymentId String?
  /// 2e acompte du 3 fois : étape de projet qui l'a rendu exigible, et quand.
  triggerStepLabel String?
  triggeredAt      DateTime?
  checkoutUrl      String?
  /// Prélèvement lancé (SEPA, environ 6 jours ouvrés) : plus de lien de paiement jusqu'à l'issue.
  paymentProcessingAt     DateTime?
  paymentProcessingMethod String?
  paidAt           DateTime?
  paymentMethod    PaymentMethod?
  manualReference  String?
  manualNotes      String?
  /// Facture générée pour ce jalon (dénormalisé, sync avec Invoice.milestoneId)
  invoiceId        String?
  /// Facture d'acompte/solde générée (lien 1-1 via Invoice.milestoneId)
  generatedInvoice Invoice?              @relation("MilestoneInvoice")
  webhookEvents    RevolutWebhookEvent[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([quoteId])
  @@index([status])
  @@index([invoiceId])
  @@index([dueDate])
  @@index([revolutOrderId])
}

model RevolutWebhookEvent {
  id          String            @id @default(cuid())
  /// Identifiant unique Revolut (idempotence)
  eventId     String            @unique
  eventType   String
  payload     Json
  processedAt DateTime          @default(now())
  milestoneId String?
  milestone   PaymentMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)

  @@index([milestoneId])
  @@index([eventType])
}

model InvoiceLine {
  id                     String        @id @default(cuid())
  invoiceId              String
  invoice                Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  position               Int
  description            String
  quantity               Decimal
  unitPriceCents         Int
  lineTotalCents         Int
  /// Ligne d'abonnement mensuel (1ʳᵉ échéance dans le total du document)
  isSubscription         Boolean       @default(false)
  billingDay             Int?
  /// MONTH | YEAR (null = MONTH) : périodicité de l'abonnement de la ligne
  billingInterval        String?
  /// Départ de la facturation (ligne d'abonnement de devis) : SIGNATURE | DELIVERY | DATE | FREE_MONTHS ; null = défaut du devis
  subscriptionStart      String?
  /// 1re facture à cette date (subscriptionStart = DATE)
  subscriptionStartDate  DateTime?
  /// Mois offerts avant la 1re facture, comptés depuis le départ par défaut (subscriptionStart = FREE_MONTHS)
  subscriptionFreeMonths Int?
  /// Ligne d'abonnement de devis : durée d'engagement en mois (12, 24 ou 36) ; null = sans engagement
  commitmentMonths       Int?
  serviceId              String?
  service                Service?      @relation(fields: [serviceId], references: [id])
  /// Rempli quand le Subscription a été créé (idempotence)
  subscriptionId         String?
  subscription           Subscription? @relation("SubscriptionLines", fields: [subscriptionId], references: [id])
  /// Devis d'avenant : abonnement révisé par cette ligne (mis à jour à l'acceptation au lieu d'en créer un)
  revisesSubscriptionId  String?
  revisesSubscription    Subscription? @relation("SubscriptionRevisions", fields: [revisesSubscriptionId], references: [id], onDelete: SetNull)
  /// Avenant signé sans décalage de l'échéance (posé à la signature) : décalée à la conversion en facture, une fois.
  /// false pour un devis signé avant la migration 20261215090000 (décalé à la signature).
  revisionShiftDeferred  Boolean       @default(false)
  /// Titre du pack sous lequel la ligne est groupée (PDF, e-mail, vue) ; null hors pack
  groupTitle             String?
  /// Ligne « Remise pack » : prix du pack moins la somme de ses lignes ponctuelles (montant négatif)
  isPackDiscount         Boolean       @default(false)
  /// Devis à propositions : proposition de la ligne (aucune ligne commune) ; null pour un devis simple
  optionId               String?
  option                 QuoteOption?  @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([optionId])
  @@index([serviceId])
  @@index([subscriptionId])
  @@index([revisesSubscriptionId])
}

model Payment {
  id                    String           @id @default(cuid())
  invoiceId             String?
  invoice               Invoice?         @relation(fields: [invoiceId], references: [id])
  amountCents           Int
  paidAt                DateTime
  method                PaymentMethod    @default(BANK_TRANSFER)
  reference             String?
  notes                 String?
  /// Identifiant PaymentIntent Stripe (pi_…)
  stripePaymentIntentId String?          @unique
  /// Frais Stripe (centimes) : information, hors livre des recettes
  feeCents              Int?
  /// Remboursé par Stripe sur ce paiement (charge.amount_refunded, cumulé)
  refundedCents         Int              @default(0)
  /// En litige (charge.dispute.*) : remis à 0 si le litige est gagné
  disputedCents         Int              @default(0)
  /// Versement Stripe vers le compte pro qui a inclus ce paiement
  stripePayoutId        String?
  stripePayout          StripePayout?    @relation(fields: [stripePayoutId], references: [id], onDelete: SetNull)
  /// Reçu de ce règlement : PDF archivé (data/uploads/receipts), servi tel quel ensuite
  receiptPdfPath        String?
  receiptPdfSha256      String?
  receiptArchivedAt     DateTime?
  /// Version lisible du reçu, figée avec son PDF archivé
  receiptReadableSnapshot String?
  createdAt             DateTime         @default(now())
  bankTransaction       BankTransaction?

  @@index([invoiceId])
  @@index([paidAt])
  @@index([stripePayoutId])
}

/// Versement Stripe vers le compte bancaire (Revolut Pro).
model StripePayout {
  id               String    @id @default(cuid())
  /// Identifiant Payout Stripe (po_…)
  stripePayoutId   String    @unique
  amountCents      Int
  /// Date d'arrivée prévue sur le compte bancaire
  arrivalDate      DateTime?
  status           String
  /// Versement demandé depuis l'ERP (bouton « Verser ») : auteur et date ; null = versement automatique Stripe.
  requestedByEmail String?
  requestedAt      DateTime?
  /// Motif de l'échec renvoyé par Stripe (payout.failed)
  failureMessage   String?
  /// Retenues prises sur ce versement : remboursements, litiges, ajustements (somme positive)
  deductionsCents  Int?
  createdAt        DateTime  @default(now())
  payments         Payment[]

  @@index([arrivalDate])
  @@index([status])
}

/// Retrait de l'entrepreneur saisi à la main (virement hors Stripe) : déduit du salaire disponible.
model OwnerWithdrawal {
  id             String   @id @default(cuid())
  amountCents    Int
  date           DateTime
  note           String?
  createdByEmail String?
  createdAt      DateTime @default(now())

  @@index([date])
}

/// Événement webhook Stripe traité (idempotence).
model StripeWebhookEvent {
  id          String   @id @default(cuid())
  /// Identifiant unique Stripe (evt_…)
  eventId     String   @unique
  eventType   String
  payload     Json
  processedAt DateTime @default(now())
  /// PROCESSING (réservé au début du traitement) | DONE (traité) ; migration 20261220090000
  status      String   @default("DONE")
  /// Réservation du traitement : une ligne PROCESSING plus ancienne que 15 min (arrêt brutal) est reprise
  claimedAt   DateTime?

  @@index([eventType])
  @@index([processedAt])
}

enum BankTxStatus {
  PENDING
  MATCHED
  UNMATCHED
  IGNORED
}

enum BankIgnoreCategory {
  FRAIS_BANCAIRES
  AUTRE
}

enum SalaryPayoutStatus {
  DRAFT
  PENDING_CONFIRMATION
  COMPLETED
  FAILED
  CANCELLED
}

/// Transaction importée depuis Revolut Business (crédits / débits).
model BankTransaction {
  id               String              @id @default(cuid())
  /// ID unique Revolut (idempotence)
  revolutId        String              @unique
  bookedAt         DateTime
  /// Positif = crédit entrant (encaissement), négatif = débit
  amountCents      Int
  currency         String              @default("EUR")
  counterpartyName String?
  counterpartyIban String?
  reference        String?
  /// État brut Revolut (pending, completed, ...)
  revolutState     String?
  status           BankTxStatus        @default(UNMATCHED)
  ignoreCategory   BankIgnoreCategory?
  matchedInvoiceId String?
  matchedInvoice   Invoice?            @relation(fields: [matchedInvoiceId], references: [id])
  paymentId        String?             @unique
  payment          Payment?            @relation(fields: [paymentId], references: [id])
  /// Suggestion JSON (ids factures + écarts) pour revue manuelle
  suggestionsJson  String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([status])
  @@index([bookedAt])
  @@index([amountCents])
  @@index([matchedInvoiceId])
}

model BankSyncLog {
  id           String    @id @default(cuid())
  startedAt    DateTime
  finishedAt   DateTime?
  imported     Int       @default(0)
  updated      Int       @default(0)
  matchedAuto  Int       @default(0)
  unmatched    Int       @default(0)
  errorMessage String?
  createdAt    DateTime  @default(now())

  @@index([startedAt])
}

/// Bénéficiaire virement (ex. compte perso) : PII chiffrées AES-GCM.
model RevolutBeneficiary {
  id            String         @id @default(cuid())
  label         String
  nameEncrypted String
  ibanEncrypted String
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  payouts       SalaryPayout[]
}

model SalaryPayout {
  id             String              @id @default(cuid())
  amountCents    Int
  currency       String              @default("EUR")
  status         SalaryPayoutStatus  @default(DRAFT)
  revolutDraftId String?
  beneficiaryId  String?
  beneficiary    RevolutBeneficiary? @relation(fields: [beneficiaryId], references: [id])
  notes          String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([status])
  @@index([createdAt])
}

enum EmailOutboxStatus {
  /// À valider par l'admin (file « E-mails à valider ») : jamais envoyé tant qu'il n'est pas validé
  REVIEW
  PENDING
  SENDING
  SENT
  FAILED
  /// Refusé à la validation : jamais envoyé
  REJECTED
}

model EmailOutbox {
  id               String            @id @default(cuid())
  status           EmailOutboxStatus @default(PENDING)
  attempts         Int               @default(0)
  maxAttempts      Int               @default(3)
  scheduledAt      DateTime          @default(now())
  sentAt           DateTime?
  lastError        String?
  /// JSON : to, subject, text, html, headers, attachments, clientId, documentId, threadId, kind.
  /// Ancienne colonne en clair : "" depuis le chiffrement (lecture : payloadEncrypted, à défaut payload)
  payload          String
  /// Même JSON, chiffré ; vidé (avec payload) 30 jours après l'envoi, la ligne reste
  payloadEncrypted String?
  /// Origine de l'envoi : WORKER, WEBHOOK, CLIENT_ACTION, ADMIN_ACTION ou CLICK (file « E-mails à valider »)
  origin           String?
  /// Famille lisible de l'e-mail (reçu, relance, lien de paiement…) : validation d'office réglable par famille
  reviewFamily     String?
  /// kind technique de l'e-mail (copie hors du contenu chiffré) : anti-doublons des rappels d'un même jalon
  reviewKind       String?
  /// Document ou jalon concerné (sans donnée personnelle) : lien depuis la file, anti-doublons
  documentId       String?
  /// « Le client attend » : reçus, échecs de paiement, liens envoyés après une signature
  clientWaiting    Boolean           @default(false)
  reviewedAt       DateTime?
  /// Motif du refus, chiffré ; jamais envoyé au client
  rejectReason     String?
  /// Dernier rappel « e-mail en attente depuis plus de 24 h »
  reviewReminderAt DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([status, scheduledAt])
  @@index([status, createdAt])
  @@index([documentId, status])
}

model EmailThread {
  id             String         @id @default(cuid())
  clientId       String?
  client         Client?        @relation(fields: [clientId], references: [id])
  subject        String
  participants   String // JSON string[]
  lastMessageAt  DateTime
  hasAttachments Boolean        @default(false)
  unreadCount    Int            @default(0)
  isStarred      Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  messages       EmailMessage[]

  quoteAcceptanceAudits QuoteAcceptanceAudit[]

  @@index([clientId])
  @@index([lastMessageAt])
  @@index([clientId, lastMessageAt])
  @@index([isStarred])
}

model QuoteAcceptanceAudit {
  id                  String       @id @default(cuid())
  quoteId             String
  quote               Invoice      @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  signerName          String
  /// PORTAL | THREAD | ADMIN
  source              String
  threadId            String?
  thread              EmailThread? @relation(fields: [threadId], references: [id], onDelete: SetNull)
  userId              String?
  userEmail           String?
  /// Preuve de signature (portail) : IP et navigateur du signataire.
  ipAddress           String?
  userAgent           String?
  /// PDF du devis signé, archivé dans data/uploads, et son empreinte SHA-256 (hex).
  pdfPath             String?
  pdfSha256           String?
  /// Signature portail : TYPED (nom saisi) | DRAWN (tracé au doigt ou à la souris)
  signatureMode       String?
  /// Tracé de la signature (data URL PNG), seulement en mode DRAWN
  signatureImage      String?
  /// Société représentée (client professionnel)
  signerCompany       String?
  /// Adresse ayant reçu le code de signature, masquée (j***@exemple.fr)
  verifiedEmailMasked String?
  codeVerifiedAt      DateTime?
  /// Authentification à la signature : SIGN_CODE (code de signature du devis) | PORTAL_SESSION (session /suivi ouverte
  /// par le code de connexion, codeVerifiedAt = heure de connexion) ; null = preuve antérieure (code de signature).
  authMethod          String?
  /// Devis tel que présenté au client juste avant sa signature, archivé, et son empreinte SHA-256
  originalPdfPath     String?
  originalPdfSha256   String?
  /// Formule de paiement retenue à la signature (TWO | THREE)
  paymentPlan         String?
  /// CGV acceptées en ligne (false : signature hors espace client ou CGV non publiées ; null : avant ce suivi)
  cgvAccepted         Boolean?
  cgvUrl              String?
  cgvVersion          String?
  /// Client consommateur (particulier) à la signature : droit de rétractation de 14 jours
  consumer            Boolean?
  /// Consommateur : exécution demandée avant la fin du délai de rétractation
  expressExecution    Boolean?
  /// Fin du délai de rétractation (dernier jour inclus, fin de journée à Paris)
  withdrawalEndsAt    DateTime?
  /// Devis à propositions : proposition retenue, copiée à la signature (identifiant, libellé, total), jamais modifiée
  optionId            String?
  optionLabel         String?
  optionTotalCents    Int?
  createdAt           DateTime     @default(now())

  @@index([quoteId])
  @@index([threadId])
}

model EmailMessage {
  id               String            @id @default(cuid())
  threadId         String
  thread           EmailThread       @relation(fields: [threadId], references: [id], onDelete: Cascade)
  folderId         String?
  folder           MailFolder?       @relation(fields: [folderId], references: [id], onDelete: SetNull)
  direction        EmailDirection
  messageId        String            @unique
  inReplyTo        String?
  referencesHeader String?
  fromAddress      String
  fromName         String?
  /// Reply-To d'un message entrant quand il diffère du From (formulaire Web3Forms : le prospect).
  replyToAddress   String?
  toAddresses      String // JSON string[]
  ccAddresses      String? // JSON string[]
  subject          String
  snippet          String?
  bodyText         String?
  bodyHtml         String?
  bodyFetched      Boolean           @default(false)
  receivedAt       DateTime
  rawHeaders       String?
  isRead           Boolean           @default(false)
  isStarred        Boolean           @default(false)
  hasAttachments   Boolean           @default(false)
  imapUid          Int?
  orphaned         Boolean           @default(false)
  /// Lu/non lu ou étoile changé dans l'ERP, pas encore écrit sur le serveur IMAP : la synchro le pousse
  /// au lieu de l'écraser par l'état du serveur.
  flagsPending     Boolean           @default(false)
  createdAt        DateTime          @default(now())
  attachments      EmailAttachment[]

  @@index([threadId, receivedAt])
  @@index([fromAddress])
  @@index([folderId, imapUid])
  @@index([isRead])
  @@index([isStarred])
}

model EmailAttachment {
  id          String       @id @default(cuid())
  messageId   String
  message     EmailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  filename    String
  mimeType    String
  sizeBytes   Int
  storagePath String
  createdAt   DateTime     @default(now())

  @@index([messageId])
}

/// Curseur IMAP (UID) par boîte
model EmailSyncState {
  id           String    @id @default(cuid())
  mailbox      String    @unique
  lastUid      Int       @default(0)
  lastSyncedAt DateTime?
  updatedAt    DateTime  @updatedAt
}

enum TestimonialStatus {
  PENDING
  PUBLISHED
  REJECTED
}

/// Ancien système d'avis interne (retiré : les avis passent par Google). Table conservée sans code :
/// elle peut contenir des avis en production, sa suppression attend l'accord d'Alexandre.
model ClientTestimonial {
  id          String            @id @default(cuid())
  clientId    String
  client      Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  authorName  String
  body        String
  status      TestimonialStatus @default(PENDING)
  publishedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([clientId])
  @@index([status, publishedAt])
}

// ---------------------------------------------------------------------------
// Espace « Site » : contenu de kouzia.com, publié dans le dépôt KouziaWebsite
// (src/content/site/*.json). Le JSON publié garde les clés françaises du contrat du site.
// ---------------------------------------------------------------------------

/// DRAFT : jamais publié ; PUBLISHED : fait partie du contenu publié ; WITHDRAWN : retiré (gardé pour l'historique).
enum SiteItemStatus {
  DRAFT
  PUBLISHED
  WITHDRAWN
}

/// Publié : « Site web » | « Logiciel »
enum SiteProjectKind {
  WEBSITE
  SOFTWARE
}

/// Publié : CLIENT | PARTENAIRE | UTILISATEUR (« Ils l'utilisent »)
enum SiteReferenceType {
  CLIENT
  PARTNER
  USER
}

/// Périmètre de l'autorisation donnée par la référence
enum SiteAuthorizationScope {
  NAME
  NAME_LOGO
  TESTIMONIAL
}

/// Publié : accueil | sitesWeb | logiciels
enum SiteFaqPage {
  HOME
  WEBSITES
  SOFTWARE
}

enum SiteMediaKind {
  CAPTURE
  MOBILE
  LOGO
  /// Image de partage (og:image) : un JPEG de 1200×630, publié sous /media/<sha12>.jpg
  PARTAGE
}

/// Réalisation (realisations.json)
model SiteProject {
  id              String          @id @default(cuid())
  /// Identifiant publié, stable : le code du site y fait référence.
  slug            String          @unique
  position        Int             @default(0)
  status          SiteItemStatus  @default(DRAFT)
  name            String
  subtitle        String?
  /// Petite ligne sous le titre de la carte (1 à 60 caractères), ex. « Développé par Kouzia au sein de La Capsule »
  mention         String?
  kind            SiteProjectKind
  text            String
  role            String?
  /// Tableau JSON de technologies
  techJson        String?
  /// Lien vers le site ou la démo (https), jamais vers le code source
  url             String
  linkLabel       String
  /// Chemin publié : /projets/<nom>.webp (repris du site) ou /media/<sha12>.webp (SiteMedia)
  imagePath       String
  /// Capture de téléphone facultative (imageMobile), même forme de chemin que imagePath
  imageMobilePath String?
  /// Texte alternatif de la capture publié (imageAlt). Null : calculé par le site ; "" : capture décorative
  imageAlt        String?
  /// Mise en avant sur l'accueil du site (miseEnAvant) : 3 au plus, brouillons compris ; décochée au retrait du site.
  featuredOnHome  Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  publishedAt     DateTime?
  /// Empreinte de la version publiée (forme écrite dans le dépôt du site) : différente de l'actuelle, statut « Modifié ».
  publishedHash   String?
  /// Page projet (/realisations/<slug>/, publiée dans « detail ») : description pour Google et textes détaillés.
  descriptionText         String?
  contextText             String?
  needText                String?
  approachText            String?
  choicesText             String?
  resultText              String?
  /// Présentation du client (sans son nom sans accord) et nom, publié seulement avec l'accord écrit.
  clientIntro             String?
  clientName              String?
  /// JSON [{ image: /media/<sha12>.webp, alt, caption?, vue? }], 6 au plus ; vue : bureau (absente) ou mobile
  capturesJson            String?
  /// JSON [{ label, url }], 4 au plus
  linksJson               String?
  /// JSON [{ vue: bureau | mobile, avant: { image, alt, date AAAA-MM, source? }, apres: { image, alt } }], 2 au plus,
  /// chaque vue une fois, les deux images d'une paire au même ratio (forme du contrat du site, detail.avantApres)
  avantApresJson          String?
  /// Nature du projet (detail.nature) : refonte ou creation ; null : non précisée
  nature                  String?
  /// Durée du projet (detail.duree), 40 caractères au plus, par exemple « 3 semaines »
  duree                   String?
  /// Client du projet : sans accord écrit, ni la page projet ni une nouvelle carte ne sont publiées.
  clientId                String?
  client                  Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  publicationConsentAt    DateTime?
  /// Forme de l'accord (« e-mail du 12/10/2026 »)
  publicationConsentNote  String?
  /// Pièce jointe privée sous data/uploads, jamais publiée
  publicationConsentFile  String?

  @@index([status, position])
  @@index([clientId])
}

/// Avis Google repris avec accord (avis.json). Note, accord et preuve ne sont jamais publiés.
model SiteReview {
  id                    String         @id @default(cuid())
  position              Int            @default(0)
  status                SiteItemStatus @default(DRAFT)
  /// Nom tel qu'affiché sur Google
  author                String
  /// Date de l'avis sur Google (AAAA-MM-JJ)
  reviewedOn            String
  /// Texte exact, figé une fois publié (une correction impose de retirer puis recréer)
  text                  String
  rating                Int?
  googleUrl             String?
  consentAt             DateTime?
  consentChannel        String?
  /// Preuve de l'accord (extrait du message), chiffrée
  consentProofEncrypted String?
  withdrawalRequestedAt DateTime?
  /// Date de l'expérience de consommation (AAAA-MM-JJ), publiée près de l'avis (D111-17 du Code de la consommation)
  experienceOn          String?
  /// Preuve de la relation client (jamais publiée) : client, et facture si connue
  clientId              String?
  client                Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  invoiceId             String?
  invoice               Invoice?       @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  /// Texte retouché (orthographe, coupe) avec l'accord écrit de l'auteur ; sinon texte exact
  alteredWithConsent    Boolean        @default(false)
  /// MANUAL (saisi dans l'ERP) | CLIENT_SPACE (déposé par le client depuis /suivi, en fin de projet)
  source                String         @default("MANUAL")
  /// Projet concerné (témoignage de l'espace client) : un seul témoignage par projet
  projectId             String?        @unique
  project               ClientProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  /// Forme du nom choisie par le client : FIRST_INITIAL (Marie D.), FULL_NAME, ORGANIZATION
  authorFormat          String?
  /// Écarté par Kouzia (hors sujet, injurieux, données personnelles), avec le motif ; l'auteur est prévenu (D111-19)
  rejectedAt            DateTime?
  rejectionReason       String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  publishedAt           DateTime?
  /// Empreinte de la version publiée (forme écrite dans le dépôt du site) : différente de l'actuelle, statut « Modifié ».
  publishedHash         String?

  @@index([status, position])
}

/// Référence (references.json) : client, partenaire ou utilisateur d'un produit, publiée avec autorisation écrite.
model SiteReference {
  id                   String                  @id @default(cuid())
  slug                 String                  @unique
  position             Int                     @default(0)
  status               SiteItemStatus          @default(DRAFT)
  type                 SiteReferenceType
  name                 String
  /// /media/<sha12>.webp (SiteMedia de type LOGO)
  logoPath             String?
  /// Texte alternatif du logo publié (logoAlt), jamais vide : nom du lien. Null : nom de la structure
  logoAlt              String?
  url                  String?
  /// slug d'une réalisation, obligatoire pour USER
  productSlug          String?
  testimonialText      String?
  testimonialAuthor    String?
  testimonialRole      String?
  authorizationAt      DateTime?
  authorizationChannel String?
  authorizationScope   SiteAuthorizationScope?
  /// Personne qui a donné l'accord (nom, e-mail), chiffrée
  contactEncrypted     String?
  /// Emplacements du logo sur le site : bandeau de l'accueil, page Réalisations
  onHome               Boolean                 @default(true)
  onProjects           Boolean                 @default(false)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  publishedAt          DateTime?
  /// Empreinte de la version publiée (forme écrite dans le dépôt du site) : différente de l'actuelle, statut « Modifié ».
  publishedHash        String?

  @@index([status, position])
}

/// Question de FAQ (faq.json)
model SiteFaq {
  id            String         @id @default(cuid())
  page          SiteFaqPage
  position      Int            @default(0)
  status        SiteItemStatus @default(DRAFT)
  question      String
  answer        String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  publishedAt   DateTime?
  /// Empreinte de la version publiée (forme écrite dans le dépôt du site) : différente de l'actuelle, statut « Modifié ».
  publishedHash String?

  @@index([page, status, position])
}

/// Documents d'un seul tenant : infos (infos.json), accroche et offres (textes.json). valueJson validé par zod selon la clé.
model SiteText {
  key           String   @id
  valueJson     String
  updatedAt     DateTime @updatedAt
  /// Empreinte de la valeur publiée : différente de l'actuelle, statut « Modifié ».
  publishedHash String?
}

/// Image normalisée (WebP, sans métadonnées) sous data/uploads/site/ : <sha12>.webp, et <sha12>-2x.webp si la source est assez grande.
/// L'original n'est jamais gardé.
model SiteMedia {
  id            String        @id @default(cuid())
  /// 12 premiers caractères hexadécimaux du SHA-256 de la version 1x : nom publié /media/<sha12>.webp
  sha12         String        @unique
  kind          SiteMediaKind
  width         Int
  height        Int
  bytes         Int
  width2x       Int?
  height2x      Int?
  bytes2x       Int?
  /// Nom lisible dans la médiathèque (admin seulement, jamais publié)
  label         String?
  /// Nom du fichier envoyé, pour le retrouver
  originalName  String?
  /// Original conservé sans métadonnées (EXIF, GPS), relatif au dossier des fichiers : recadrage ultérieur. Null : image antérieure à la médiathèque ou reprise du site
  originalPath  String?
  originalBytes Int?
  /// Point d'intérêt du recadrage, de 0 à 1 depuis le coin haut gauche de l'original. Null : recadrage automatique
  focalX        Float?
  focalY        Float?
  /// Recadrage choisi à la main d'une capture : « 16:10 », « 16:9 » ou « l:h » de l'autre image d'une paire avant / après.
  /// Null : format d'origine, sans recadrage (capture, téléphone, logo) ; l'image de partage est toujours en 1200×630
  cropRatio     String?
  createdAt     DateTime      @default(now())
}

enum SitePublicationStatus {
  PREPARING
  COMMITTED
  DISPATCHED
  BUILDING
  DEPLOYED
  LIVE
  FAILED
  NOOP
}

/// Publication du contenu vers le dépôt du site (commit Git Data, puis déploiement par l'Action du site).
model SitePublication {
  id           String                @id @default(cuid())
  status       SitePublicationStatus @default(PREPARING)
  /// "RUNNING" tant que la publication n'est pas terminée, NULL ensuite : une seule à la fois (index unique).
  lock         String?               @unique
  /// Empreinte de l'instantané publié (comparée à l'instantané courant : « modifié, non publié »).
  digest       String
  /// Fichiers ajoutés, modifiés, supprimés : { path, change }[]
  summaryJson  String
  /// Les 6 fichiers publiés ({ nom: contenu }), pour le détail des changements sans GitHub et l'historique.
  /// Gardé pour les 50 dernières publications qui en ont un, vidé au-delà (rétention).
  filesJson    String?
  baseSha      String?
  commitSha    String?
  runUrl       String?
  error        String?
  startedAt    DateTime              @default(now())
  dispatchedAt DateTime?
  finishedAt   DateTime?
  liveAt       DateTime?
  events       SiteDeployEvent[]

  @@index([startedAt])
  @@index([commitSha])
}

/// Rappel signé de l'Action de déploiement du site (X-Kouzia-Livraison unique : anti-rejeu durable).
model SiteDeployEvent {
  id            String           @id @default(cuid())
  deliveryId    String           @unique
  sha           String
  /// deploye | simulation | echec | non-configure | ignore (ancien) | refuse
  result        String
  runUrl        String?
  publicationId String?
  publication   SitePublication? @relation(fields: [publicationId], references: [id], onDelete: SetNull)
  receivedAt    DateTime         @default(now())
}

/// Renouvellement chez un tiers (hébergement et domaine en gestion autonome, au nom du client) : rien n'est
/// facturé par l'ERP. Tâche interne à J-30 dans « À traiter » ; e-mail au client seulement si notifyClient.
model ClientRenewal {
  id            String    @id @default(cuid())
  clientId      String
  client        Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// Ex. « Hébergement et domaine »
  label         String
  /// Hébergeur ou registrar (ex. Hostinger)
  provider      String?
  /// Prochaine date de renouvellement chez le tiers
  renewsAt      DateTime
  /// MONTH | YEAR : la date avance d'une période une fois l'échéance passée
  interval      String    @default("YEAR")
  notifyClient  Boolean   @default(false)
  /// Échéance (renewsAt) pour laquelle l'e-mail au client est parti
  noticeSentFor DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([clientId])
  @@index([renewsAt])
}

/// Prestation d'un pack, avec sa quantité, dans l'ordre du pack.
model ServicePackItem {
  id        String  @id @default(cuid())
  packId    String
  pack      Service @relation("PackItems", fields: [packId], references: [id], onDelete: Cascade)
  serviceId String
  service   Service @relation("PackComponent", fields: [serviceId], references: [id], onDelete: Restrict)
  quantity  Int     @default(1)
  position  Int     @default(0)

  @@unique([packId, serviceId])
  @@index([packId])
  @@index([serviceId])
}

/// Modèle d'e-mail modifié dans Réglages (clé du registre lib/email/template-registry.ts) ; absent : texte d'origine du code
model EmailTemplate {
  key       String   @id
  subject   String?
  body      String?
  updatedAt DateTime @updatedAt
}

/// Code promo (R3, 26/10/2026) : saisi par l'admin sur un devis récurrent avant émission ; usages calculés (devis émis
/// vivants avec ce code), jamais stockés. Code immuable après création (il figure sur les devis émis).
model PromoCode {
  id            String    @id @default(cuid())
  /// Majuscules, lettres, chiffres et tiret, 3 à 32 caractères
  code          String    @unique
  /// PERCENT (value en points de base) | FIXED (value en centimes par échéance)
  kind          String
  value         Int
  /// Durée en mois depuis la 1re échéance ; null = toute la durée de l'engagement
  months        Int?
  validFrom     DateTime?
  validUntil    DateTime?
  /// null = illimité
  maxUses       Int?
  /// Liste JSON des identifiants d'offres concernées ; null = toutes
  serviceIds    String?
  /// Condition imprimée sur le devis (ex. « structure créée il y a moins de 12 mois »)
  conditionText String?
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  invoices      Invoice[]
  quoteOptions  QuoteOption[]
}

/// Proposition d'un devis (P1, 27/10/2026) : formule complète (mode, offre de paiement, remise, lignes, totaux).
/// Le client en retient une à la signature ; ses réglages sont alors recopiés sur le devis.
model QuoteOption {
  id                      String         @id @default(cuid())
  quoteId                 String
  quote                   Invoice        @relation("QuoteOptions", fields: [quoteId], references: [id], onDelete: Cascade)
  /// 0 = A, 1 = B
  position                Int
  label                   String
  /// ONE_OFF | RECURRING
  billingMode             String
  /// ONE | TWO | THREE | CHOICE | NONE
  paymentPlanOffer        String?
  /// Remise ponctuelle, comme Invoice.discountType et discountValue
  discountType            String         @default("NONE")
  discountValue           Int            @default(0)
  /// Remise récurrente, comme les champs du même nom sur Invoice (une par proposition)
  recurringDiscountKind   String?
  recurringDiscountValue  Int?
  recurringDiscountMonths Int?
  openingDiscount         Boolean        @default(false)
  promoCodeId             String?
  promoCode               PromoCode?     @relation(fields: [promoCodeId], references: [id], onDelete: Restrict)
  subtotalCents           Int            @default(0)
  totalCents              Int            @default(0)
  depositBaseCents        Int?
  /// Figés à l'émission, comme sur Invoice
  legalClausesSnapshot    Json?
  paymentScheduleSnapshot String?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  lines                   InvoiceLine[]
  selectedBy              Invoice[]      @relation("SelectedOption")

  @@unique([quoteId, position])
  @@index([promoCodeId])
}
