generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum ClientType {
  B2B
  B2C
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  CANCELLED
}

enum InvoiceDocumentType {
  INVOICE
  CREDIT_NOTE
  QUOTE
}

/// Nature métier de la facture (autonome légalement ; le devis est le pivot marché)
enum InvoiceType {
  SIMPLE
  ACOMPTE
  SOLDE
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum PaymentMethod {
  BANK_TRANSFER
  CARD
  CHECK
  CASH
  OTHER
  SEPA_DEBIT
}

enum EmailDirection {
  INBOUND
  OUTBOUND
}

enum MailFolderRole {
  INBOX
  SENT
  DRAFTS
  TRASH
  JUNK
  ARCHIVE
  CUSTOM
}

/// Compte mail (extensible multi-comptes)
model MailAccount {
  id        String       @id @default(cuid())
  email     String
  label     String?
  isDefault Boolean      @default(true)
  imapHost  String?
  smtpHost  String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  folders   MailFolder[]

  @@index([isDefault])
}

/// Dossier IMAP synchronisé (ou virtuel côté ERP)
model MailFolder {
  id           String         @id @default(cuid())
  accountId    String
  account      MailAccount    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  imapPath     String
  displayName  String
  role         MailFolderRole @default(CUSTOM)
  uidValidity  Int            @default(0)
  highestUid   Int            @default(0)
  unreadCount  Int            @default(0)
  isVirtual    Boolean        @default(false)
  lastSyncedAt DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  messages     EmailMessage[]

  @@unique([accountId, imapPath])
  @@index([accountId, role])
}

/// État de connexion sync (bannière UI)
model MailSyncStatus {
  id              String   @id @default("default")
  connected       Boolean  @default(false)
  idleActive      Boolean  @default(false)
  lastError       String?
  lastSyncAt      DateTime?
  reconnectAt     DateTime?
  updatedAt       DateTime @updatedAt
}

enum UrssafPeriodicity {
  MONTHLY
  QUARTERLY
}

enum UrssafDeclarationStatus {
  DUE
  PAID
  LATE
}

enum ObligationType {
  URSSAF_DECLARATION
  CFE_PAYMENT
  CFE_INITIAL_DECLARATION
  INCOME_TAX_DECLARATION
  ACTIVITY_QUESTIONNAIRE
  ANNUAL_MISC
}

enum ObligationStatus {
  PENDING
  DONE
  LATE
}

enum ServiceUnit {
  HEURE
  JOUR
  FORFAIT
}

enum MilestoneStatus {
  PENDING
  DUE
  INVOICED
  PAID
  OVERDUE
  FAILED
  CANCELLED
}

enum CreditNoteReason {
  REFUND_DEPOSIT
  COMMERCIAL_GESTURE
  AMOUNT_CORRECTION
}

enum RefundMethod {
  BANK_TRANSFER
  DEDUCT_FROM_BALANCE
  OTHER
}

model User {
  id                         String                @id @default(cuid())
  email                      String                @unique
  name                       String?
  passwordHash               String
  /// Secret TOTP actif (base32), chiffré avec ENCRYPTION_KEY. Null = 2FA non activée.
  totpSecretEncrypted        String?
  /// Secret en cours d'enrôlement, activé après vérification d'un premier code.
  totpPendingSecretEncrypted String?
  totpEnabledAt              DateTime?
  /// Dernier pas TOTP accepté : un pas inférieur ou égal est refusé (anti-rejeu).
  totpLastStep               Int?
  /// Échecs consécutifs (mot de passe ou code) venus du tunnel, remis à zéro au succès.
  failedLogins               Int                   @default(0)
  lockedUntil                DateTime?
  /// Dernière lecture de la cloche (« Tout marquer comme lu »), commune à tous les appareils.
  notificationsSeenAt        DateTime?
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime              @updatedAt
  sessions                   Session[]
  recoveryCodes              AdminRecoveryCode[]
  loginChallenges            AdminLoginChallenge[]
  devices                    AdminDevice[]
}

/// Code de secours 2FA à usage unique, stocké haché (HMAC-SHA256).
model AdminRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// Étape intermédiaire de connexion : mot de passe validé, code TOTP attendu. id = SHA-256 du jeton du cookie.
model AdminLoginChallenge {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  attempts  Int      @default(0)
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// Appareil admin reconnu (cookie d'appareil haché) : alerte email à la première connexion.
model AdminDevice {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceHash  String
  userAgent   String?
  ipAddress   String?
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@unique([userId, deviceHash])
}

/// Session serveur (cookie httpOnly opaque)
model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// Identité émetteur (seedée depuis l'attestation INPI)
model CompanySettings {
  id            String   @id @default(cuid())
  legalName     String
  tradeName     String?
  siren         String
  siret         String
  apeCode       String
  addressLine1  String
  addressLine2  String?
  postalCode    String
  city          String
  country       String   @default("FRANCE")
  email         String?
  phone         String?
  website       String?
  vatRegime     String   @default("FRANCHISE_BASE_293B")
  vatMention    String   @default("TVA non applicable, art. 293 B du CGI")
  /// Enveloppe trésorerie / frais (budget perso, pas légal)
  treasuryRateBps Int    @default(1420)
  /// Enveloppe placements / épargne (budget perso)
  placementRateBps Int   @default(1000)
  urssafPeriodicity UrssafPeriodicity @default(MONTHLY)
  /// Jour limite URSSAF (légal AE : 15 du mois suivant) - conservé pour compat
  urssafDeadlineDay Int  @default(15)
  publicodesRegime String @default("AE_BNC_LIBERAL")
  invoicePrefix String   @default("")
  /// Templates de numérotation : {prefix}, {year}, {counter}
  invoiceNumberTemplate    String @default("F-{year}-{counter}")
  quoteNumberTemplate      String @default("D-{year}-{counter}")
  creditNoteNumberTemplate String @default("A-{year}-{counter}")
  /// Largeur du compteur (padding), défaut 4 → 0001
  numberCounterWidth       Int    @default(4)
  /// Reprise legacy : JSON { "FACTURE:2026": 7 } = lastValue initial avant incrément
  numberingLegacyStarts    Json?
  /// @deprecated préférer LegalClause - conservé en fallback
  paymentConditions String @default("Paiement à réception")
  /// @deprecated préférer LegalClause
  latePenaltiesText String @default("En cas de retard de paiement, une pénalité égale à 3 fois le taux d'intérêt légal sera due, ainsi qu'une indemnité forfaitaire de 40 € pour frais de recouvrement.")
  /// Mention obligatoire : conditions d'escompte en cas de paiement anticipé
  earlyPaymentDiscountText String @default("Escompte pour paiement anticipé : néant")
  /// @deprecated préférer LegalClause
  legalMentions String?
  /// @deprecated préférer LegalClause
  suspensionClause String @default("En cas de non-paiement d'une échéance, les prestations peuvent être suspendues jusqu'à régularisation.")
  /// Jours après émission avant 1re relance devis
  reminderQuoteDays Int @default(7)
  /// Jours après échéance avant 1re relance facture
  reminderInvoiceDays Int @default(7)
  /// Afficher les montants sur le suivi public client
  publicTrackingShowAmounts Boolean @default(false)
  /// URL du portail client (suivi devis / factures)
  clientPortalUrl String?
  /// Date de création de l'entreprise (INPI) pour délais initiaux
  businessStartDate DateTime?
  /// Date d'immatriculation au RNE (INPI / open data)
  rneRegistrationDate DateTime?
  /// Dernière année de revenus déclarée (ex. 2025 = revenus 2025 déclarés en 2026)
  lastIncomeTaxDeclaredYear Int?
  /// Montant CFE par défaut (centimes), saisi à réception de l'avis
  cfeAmountCents Int @default(25000)
  /// IBAN du compte pro (affiché sur factures pour virement client)
  bankIban String?
  /// BIC / SWIFT
  bankBic String?
  /// Titulaire du compte pro
  bankAccountHolder String?
  /// Nom de la banque (ex. Revolut)
  bankName String?
  /// Facture des particuliers (médiation conso)
  b2cActivity Boolean @default(false)
  /// Mention médiation consommation (affichée sur le PDF si b2cActivity=true)
  mediationClause String?
  /// Rappel déclaration revenus : mois (1-12), défaut avril
  incomeTaxReminderMonth Int @default(4)
  /// Rappel déclaration revenus : jour, défaut 15
  incomeTaxReminderDay Int @default(15)
  /// Liens officiels (JSON) : urssafDeclaration, impotsPro, impotsParticulier
  officialLinks Json?
  /// Lien fiche entreprise data.inpi.fr
  inpiUrl String?
  /// SMTP optionnel (prioritaire sur les variables d'environnement si renseigné)
  smtpHost          String?
  smtpPort          Int?
  smtpSecure        Boolean @default(false)
  /// SSL | STARTTLS | NONE (null = dérivé de smtpSecure)
  smtpEncryption    String?
  smtpUser          String?
  smtpPassEncrypted String?
  smtpPassHint      String?
  smtpFrom          String?
  smtpFromName      String?
  smtpReplyTo       String?
  /// Expéditeur des e-mails automatiques (codes, invitation, accès, alertes), ex. noreply@kouzia.com.
  /// Vide : smtpFrom. Les réponses vont au Reply-To (contact@).
  transactionalFrom String?
  /// Plafond d'envois (emails / minute)
  emailThrottlePerMinute Int @default(30)

  /// IMAP (réception). Prioritaire sur IMAP_* du .env si hôte + utilisateur renseignés.
  imapHost          String?
  imapPort          Int?
  imapSecure        Boolean @default(true)
  imapUser          String?
  imapPassEncrypted String?
  imapPassHint      String?
  imapMailbox       String  @default("INBOX")
  imapPollIntervalMinutes Int @default(15)

  /// Mapping dossiers IMAP (null = auto-détection Hostinger)
  imapFolderInbox   String?
  imapFolderSent    String?
  imapFolderDrafts  String?
  imapFolderTrash   String?
  imapFolderJunk    String?
  imapFolderArchive String?

  /// Signature email (HTML) insérée dans les nouveaux messages
  emailSignatureHtml String?
  /// Notifications navigateur pour nouveaux emails
  emailBrowserNotifications Boolean @default(false)

  /// Plafonds pièces jointes IMAP (stockage ERP). Défauts calés sur un mail riche (PDF + photos + video courte).
  attachmentMaxFileMb    Int @default(50)
  attachmentMaxMessageMb Int @default(80)

  /// Identité légale (PDF, emails, portail)
  legalForm              String?
  rcsMention             String?
  vatIntraNumber         String?
  decennaleInsurer       String?
  decennalePolicyNumber  String?
  decennaleCoverageZone  String?

  /// Charte documents (PDF / emails)
  brandPrimaryColor   String  @default("#0f766e")
  brandSecondaryColor String  @default("#0f172a")
  brandLogoPath       String?
  pdfFooterText       String?

  /// Revolut Merchant API (encaissement en ligne). Distinct de la Business API bancaire.
  revolutMerchantApiKeyEncrypted   String?
  revolutMerchantApiKeyHint        String?
  revolutWebhookSecretEncrypted    String?
  revolutWebhookSecretHint         String?
  /// sandbox | production
  revolutMerchantMode              String @default("sandbox")

  /// Échéancier d'acomptes (bps, 10000 = 100 %) : acompte + solde
  depositCount            Int @default(2)
  depositPercent1Bps      Int @default(3000)
  depositPercent2Bps      Int @default(7000)
  depositPercent3Bps      Int @default(0)
  /// Paiement en 3 fois : acompte, 2e acompte (étape de projet), solde. Somme = 10000.
  split3Percent1Bps       Int @default(3000)
  split3Percent2Bps       Int @default(4000)
  split3Percent3Bps       Int @default(3000)
  /// Total minimal (centimes) pour proposer le 3 fois ; en dessous, l'offre retombe sur 2 fois.
  split3MinTotalCents     Int @default(50000)
  /// Nouveaux devis : proposer au client le choix entre 2 et 3 fois.
  paymentChoiceDefault    Boolean @default(false)
  /// Déclencheur imprimé pour le 2e acompte du 3 fois.
  split3Step2TriggerText  String @default("À la validation de l'étape définie dans le suivi de projet")
  /// Jours avant échéance où le bouton de paiement Revolut est créé / activé
  paymentButtonLeadDays   Int @default(7)
  /// Position du jalon 2 sur la durée du projet (5000 = 50 %)
  projectMilestoneMidBps  Int @default(5000)

  /// Rappels d'acomptes (délais en jours, activables)
  reminderDepositMinus7Days    Int     @default(7)
  reminderDepositMinus1Days    Int     @default(1)
  reminderDepositPlus3Days     Int     @default(3)
  reminderDepositPlus10Days    Int     @default(10)
  reminderDepositMinus7Enabled Boolean @default(true)
  reminderDepositMinus1Enabled Boolean @default(true)
  reminderDepositPlus3Enabled  Boolean @default(true)
  reminderDepositPlus10Enabled Boolean @default(true)

  /// Google Calendar (OAuth) : sync événements obligations vers Agenda
  googleCalendarRefreshTokenEncrypted String?
  googleCalendarRefreshTokenHint      String?
  googleCalendarConnectedEmail        String?
  googleCalendarEnabled               Boolean @default(false)
  /// Destinataire emails de rappel obligations (hors ClientEmailEvent)
  obligationReminderEmail             String  @default("kouziaeffa.pro@gmail.com")
  obligationEmailRemindersEnabled     Boolean @default(true)

  /// Modules ERP (affichage nav + pages). Banque off par défaut (Revolut Pro sans API).
  moduleBankEnabled          Boolean @default(false)
  moduleSubscriptionsEnabled Boolean @default(true)
  /// @deprecated remplacé par moduleStripeEnabled. Conservé en base (SQLite).
  moduleMerchantApiEnabled   Boolean @default(false)

  /// Stripe : encaissement en ligne, catalogue et abonnements.
  moduleStripeEnabled              Boolean @default(false)
  stripeSecretKeyEncrypted         String?
  stripeSecretKeyHint              String?
  stripeWebhookSecretEncrypted     String?
  stripeWebhookSecretHint          String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// Journal des modifications de Paramètres (jamais de valeurs secrètes)
model SettingsAuditLog {
  id        String   @id @default(cuid())
  userId    String?
  userEmail String?
  tab       String
  field     String
  createdAt DateTime @default(now())

  @@index([tab, createdAt])
  @@index([createdAt])
}

enum LegalClauseKind {
  VAT
  PAYMENT
  PENALTY
  SUSPENSION
  CUSTOM
}

/// Conditions / mentions légales gérables (comme le catalogue prestations)
model LegalClause {
  id        String          @id @default(cuid())
  kind      LegalClauseKind @default(CUSTOM)
  title     String
  body      String
  /// Clause légale obligatoire (non supprimable)
  required  Boolean         @default(false)
  active    Boolean         @default(true)
  position  Int             @default(0)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([active, position])
}

/// Obligation administrative générique (URSSAF, CFE, impôts, etc.)
model Obligation {
  id             String           @id @default(cuid())
  type           ObligationType
  /// Clé période : "2026-07", "2026-Q2", "2026", "ONCE"
  period         String
  dueDate        DateTime
  status         ObligationStatus @default(PENDING)
  completedAt    DateTime?
  /// Montant dû en centimes (nullable si inconnu)
  amountCents    Int?
  notes          String?
  label          String
  /// Justificatif PDF téléversé (chemin relatif data/uploads/…)
  attachmentPath String?
  attachmentName String?
  attachmentMime String?
  /// Id événement Google Calendar (échéance / clôture)
  googleCalendarEventId String?
  /// Id événement Google Calendar (ouverture de la fenêtre déclarative)
  googleCalendarOpenEventId String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  reminderLogs   ObligationReminderLog[]

  @@unique([type, period])
  @@index([status])
  @@index([dueDate])
  @@index([type])
  @@index([completedAt])
}

/// Idempotence des emails de rappel obligations (J-7, J-3, J-1, jour J)
model ObligationReminderLog {
  id           String     @id @default(cuid())
  obligationId String
  obligation   Obligation @relation(fields: [obligationId], references: [id], onDelete: Cascade)
  /// j7 | j3 | j1 | j0
  stage        String
  sentAt       DateTime   @default(now())

  @@unique([obligationId, stage])
  @@index([sentAt])
}

/// Checklist démarches post-création (une seule ligne)
model StartupChecklist {
  id                    String   @id @default(cuid())
  urssafAccount         Boolean  @default(false)
  impotsProAccount      Boolean  @default(false)
  activityQuestionnaire Boolean  @default(false)
  cfeInitialDeclaration Boolean  @default(false)
  rcpInsurance          Boolean  @default(false)
  mediationChecked      Boolean  @default(false)
  dedicatedBankAccount  Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

/// Compteur nommé (ex. name=client pour CLI-0001) - hors séries documents
model NamedCounter {
  name      String @id
  lastValue Int    @default(0)
}

/// Séries légales de numérotation documents (art. 242 nonies CGI)
enum NumberingDocumentType {
  FACTURE
  DEVIS
  AVOIR
}

/// Compteur atomique par (type document, exercice)
model Counter {
  id           String                @id @default(cuid())
  documentType NumberingDocumentType
  year         Int
  lastValue    Int                   @default(0)

  @@unique([documentType, year])
  @@index([documentType])
}

/// Historique des déclarations / virements URSSAF (période M ou trimestre)
model UrssafDeclaration {
  id              String                   @id @default(cuid())
  /// Clé unique période : "2026-07" (mensuel) ou "2026-Q2" (trimestriel)
  periodKey       String                   @unique
  periodicity     UrssafPeriodicity
  periodStart     DateTime
  periodEnd       DateTime
  deadline        DateTime
  /// CA encaissé de la période (centimes)
  encaisseCents   Int
  /// Montant dû calculé Publicodes (centimes)
  amountDueCents  Int
  status          UrssafDeclarationStatus  @default(DUE)
  paidAt          DateTime?
  paymentRef      String?
  notes           String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@index([status])
  @@index([deadline])
}

model Client {
  id             String        @id @default(cuid())
  /// Numéro public CLI-0001
  clientNumber   String?       @unique
  type           ClientType
  displayName    String
  firstName      String?
  lastName       String?
  companyName    String?
  emailEncrypted String?
  /// HMAC-SHA256 de l'email normalisé (lookup messagerie sans decrypt)
  emailHash      String?       @unique
  phoneEncrypted String?
  siretEncrypted String?
  sirenEncrypted String?
  /// Code NAF/APE (open data)
  apeCode        String?
  /// Date de dernière vérification via recherche-entreprises
  companyVerifiedAt DateTime?
  addressLine1   String?
  addressLine2   String?
  postalCode     String?
  city           String?
  country        String        @default("FRANCE")
  /// Code INSEE commune (BAN)
  addressCityCode String?
  addressLat     Float?
  addressLon     Float?
  notes          String?
  /// JSON [{ id, label, done }] : besoins notés en rendez-vous (ordre du tableau = ordre affiché)
  needs          String    @default("[]")
  /// Date à laquelle le client a complété son onboarding (via invitation)
  onboardingCompletedAt  DateTime?
  /// Date du dernier envoi de l'e-mail d'accès à l'espace client
  accessEmailSentAt      DateTime?
  /// Première connexion à l'espace client par code e-mail : l'adresse est confirmée
  emailVerifiedAt        DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  portalCodes    PortalCode[]
  portalSessions PortalSession[]
  invoices       Invoice[]
  emailThreads   EmailThread[]
  emailEvents    ClientEmailEvent[]
  subscriptions  Subscription[]
  onboardingAsExisting OnboardingInvitation[] @relation("OnboardingExisting")
  onboardingAsCreated  OnboardingInvitation[] @relation("OnboardingCreated")

  testimonials        ClientTestimonial[]
  projects            ClientProject[]
  /// Identifiant Customer Stripe (cus_…)
  stripeCustomerId    String?       @unique

  @@index([displayName])
  @@index([type])
}

/// Code à 6 chiffres envoyé par e-mail : connexion à l'espace client (LOGIN) ou signature d'un devis (SIGN).
model PortalCode {
  id        String    @id @default(cuid())
  clientId  String
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// LOGIN | SIGN
  purpose   String
  /// Devis concerné (SIGN)
  quoteId   String?
  /// HMAC-SHA256 du code : jamais stocké en clair
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([clientId, purpose, createdAt])
}

/// Appareil reconnu après un code de connexion (cookie httpOnly, 15 jours).
model PortalSession {
  id         String    @id @default(cuid())
  clientId   String
  client     Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// SHA-256 du jeton : le jeton clair n'existe que dans le cookie du navigateur
  tokenHash  String    @unique
  /// SHA-256 de l'identifiant d'appareil (cookie longue durée) : repère un nouvel appareil
  deviceHash String
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  @@index([clientId])
}

/// Avancement d'un projet client, affiché dans l'espace client (/suivi) quand visible.
model ClientProject {
  id              String   @id @default(cuid())
  clientId        String
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name            String
  /// 0 à 100
  progress        Int      @default(0)
  /// JSON [{ label, status: done|current|todo, date?: YYYY-MM-DD }]
  steps           String   @default("[]")
  /// JSON [{ label, url (https) }]
  links           String   @default("[]")
  /// JSON [{ label, done, note? }]
  checklist       String   @default("[]")
  visibleOnPortal Boolean  @default(true)
  position        Int      @default(0)
  /// Devis d'origine : le projet naît de la facture d'acompte (ou totale) de ce devis.
  quoteId         String?  @unique
  quote           Invoice? @relation("QuoteProject", fields: [quoteId], references: [id], onDelete: SetNull)
  /// PLANNED (acompte facturé, en attente de paiement) | ACTIVE (démarré) | DONE
  status          String   @default("ACTIVE")
  startedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([clientId, position])
}

/// Journal des emails sortants vers un client (suivi portail /admin)
model ClientEmailEvent {
  id             String   @id @default(cuid())
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  kind           String
  subject        String
  toAddress      String
  documentId     String?
  documentNumber String?
  success        Boolean  @default(true)
  errorMessage   String?
  sentAt         DateTime @default(now())
  outboxId       String?
  threadId       String?

  @@index([clientId, sentAt])
  @@index([documentId])
  @@index([outboxId])
  @@index([threadId])
}

/// Invitation envoyée à un prospect/client pour qu'il remplisse sa fiche lui-même.
/// existingClientId null = création d'un nouveau client à la soumission ;
/// existingClientId renseigné = mise à jour du client existant.
model OnboardingInvitation {
  id              String    @id @default(cuid())
  /// Email de destination de l'invitation
  email           String
  /// Token secret du lien /onboarding/:token (legacy hex) ou jti HMAC
  token           String    @unique
  /// Identifiant unique pour idempotence HMAC (UUID)
  jti             String?   @unique
  /// Date d'expiration du token
  expiresAt       DateTime
  /// Date de soumission du formulaire (null = pas encore rempli)
  usedAt          DateTime?
  /// Client existant à mettre à jour (null = nouveau client à créer)
  existingClient  Client?   @relation("OnboardingExisting", fields: [existingClientId], references: [id], onDelete: SetNull)
  existingClientId String?
  /// Client créé à la soumission (quand existingClient est null)
  createdClient   Client?   @relation("OnboardingCreated", fields: [createdClientId], references: [id], onDelete: SetNull)
  createdClientId  String?
  createdAt       DateTime  @default(now())

  @@index([email])
}

model Service {
  id                  String      @id @default(cuid())
  name                String
  description         String?
  unitPriceCents      Int
  unit                ServiceUnit @default(FORFAIT)
  active              Boolean     @default(true)
  /// Prestation d'abonnement mensuel (utilisable sur devis/facture)
  isSubscription      Boolean     @default(false)
  /// Jour de facturation par défaut (1-28) si isSubscription
  defaultBillingDay   Int         @default(1)
  /// Identifiant Product Stripe (prod_…)
  stripeProductId     String?
  /// Identifiant Price Stripe (price_…) : une prestation ERP = un prix
  stripePriceId       String?     @unique
  /// MONTH | YEAR | null (prestation ponctuelle)
  billingInterval     String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  subscriptions       Subscription[]
  invoiceLines        InvoiceLine[]

  @@index([active])
  @@index([name])
  @@index([stripeProductId])
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  ENDED
}

enum SubscriptionCollectionMethod {
  MANUAL_TRANSFER
  SEPA_DEBIT
  /// Encaissement géré par Stripe Billing (webhooks invoice.*)
  STRIPE
}

model Subscription {
  id              String             @id @default(cuid())
  clientId        String
  client          Client             @relation(fields: [clientId], references: [id])
  serviceId       String
  service         Service            @relation(fields: [serviceId], references: [id])
  /// Libellé de la facture récurrente (ex. "Maintenance site web : mensuel")
  label           String
  /// Montant HT par échéance (centimes). Franchise TVA → HT = TTC.
  amountCents     Int
  /// Jour du mois de facturation (1-28 pour éviter débordement)
  billingDay      Int
  startDate       DateTime
  /// null = actif indéfiniment
  endDate         DateTime?
  status          SubscriptionStatus @default(ACTIVE)
  collectionMethod SubscriptionCollectionMethod @default(MANUAL_TRANSFER)
  /// Identifiant Subscription Stripe (sub_…)
  stripeSubscriptionId String?       @unique
  /// MONTH | YEAR (copie du prix Stripe)
  billingInterval String?
  /// Prochaine date d'émission de facture
  nextInvoiceAt   DateTime
  /// Dernière facture générée par cet abonnement
  lastInvoiceId   String?
  invoices        Invoice[]
  sourceLines     InvoiceLine[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([status])
  @@index([nextInvoiceAt])
  @@index([clientId])
}

model Invoice {
  id                String              @id @default(cuid())
  /// Numéro légal (documentNumber) : null en brouillon, unique et immuable une fois émis
  number            String?             @unique
  documentType      InvoiceDocumentType @default(INVOICE)
  /// SIMPLE | ACOMPTE | SOLDE (chaque facture reste autonome)
  invoiceType       InvoiceType         @default(SIMPLE)
  status            InvoiceStatus       @default(DRAFT)
  /// Statut métier devis (null pour factures / avoirs)
  quoteStatus       QuoteStatus?
  /// Décision du client sur un devis : horodatage, motif de refus, nom du signataire
  quoteDecidedAt    DateTime?
  quoteRejectReason String?
  /// Nom saisi lors d'une acceptation en ligne (vaut bon pour accord)
  quoteSignerName   String?
  clientId          String
  client            Client              @relation(fields: [clientId], references: [id])
  clientSnapshot    Json?
  issueDate         DateTime?
  /// Date de réalisation de la prestation (mention obligatoire, distincte de l'émission)
  serviceDate       DateTime?
  /// Référence du bon de commande de l'acheteur, quand il en fournit un
  purchaseOrderRef  String?
  dueDate           DateTime?
  validUntil        DateTime?
  sequenceYear      Int?
  sequenceNumber    Int?
  currency          String              @default("EUR")
  subtotalCents     Int                 @default(0)
  totalCents        Int                 @default(0)
  /// NONE | PERCENT (discountValue en bps, 1000 = 10 %) | FIXED (discountValue en centimes)
  discountType      String              @default("NONE")
  discountValue     Int                 @default(0)
  /// Total du marché (devis) figé à l'émission d'un acompte/solde
  marketTotalCents  Int?
  notes             String?
  paymentTerms      String?             @default("Paiement à réception")
  /// Facture d'origine pour un avoir (originalInvoiceId)
  creditedInvoiceId String?
  creditedInvoice   Invoice?            @relation("CreditNotes", fields: [creditedInvoiceId], references: [id])
  creditNotes       Invoice[]           @relation("CreditNotes")
  /// Motif métier de l'avoir (uniquement CREDIT_NOTE)
  creditReason         CreditNoteReason?
  creditReasonDetail   String?
  refundMethod         RefundMethod?
  /// Confirmation CGV : acompte remboursable (null si non applicable)
  cgvDepositRefundable Boolean?
  /// Devis : formules proposées, TWO | THREE | CHOICE (null = échéancier historique). Figée à l'émission.
  paymentPlanOffer  String?
  /// Devis accepté : formule retenue, TWO | THREE.
  paymentPlan       String?
  /// Checklist suivi post-avoir (JSON)
  creditFollowUp       Json?
  /// Pivot marché : devis commun (nullable si facture hors marché)
  quoteId           String?
  quote             Invoice?            @relation("MarketInvoices", fields: [quoteId], references: [id])
  marketInvoices    Invoice[]           @relation("MarketInvoices")
  /// @deprecated préférer quoteId - conservé pour compat conversions
  sourceQuoteId     String?
  sourceQuote       Invoice?            @relation("QuoteConversions", fields: [sourceQuoteId], references: [id])
  convertedInvoices Invoice[]           @relation("QuoteConversions")
  /// Jalon d'origine (FK côté facture, sync avec PaymentMilestone.invoiceId)
  milestoneId       String?             @unique
  sourceMilestone   PaymentMilestone?   @relation("MilestoneInvoice", fields: [milestoneId], references: [id])
  /// Abonnement d'origine (null pour les factures ponctuelles)
  subscriptionId    String?
  subscription      Subscription?       @relation(fields: [subscriptionId], references: [id])
  lines             InvoiceLine[]
  payments          Payment[]
  bankTransactions  BankTransaction[]
  milestones        PaymentMilestone[]  @relation("QuoteMilestones")
  lastReminderAt    DateTime?
  reminderCount     Int                 @default(0)
  nextReminderAt    DateTime?
  issuedAt          DateTime?
  /// @deprecated Revolut Merchant. Conservé en base (SQLite).
  revolutOrderId    String?
  /// Lien ERP permanent /api/public/pay/… (ou URL collée à la main)
  checkoutUrl       String?
  /// Identifiant Invoice Stripe (in_…) : une échéance Billing = une facture ERP
  stripeInvoiceId   String?             @unique
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  quoteAcceptanceAudits QuoteAcceptanceAudit[]

  @@unique([sequenceYear, sequenceNumber, documentType])
  @@index([status])
  @@index([clientId])
  @@index([issueDate])
  @@index([documentType])
  @@index([invoiceType])
  @@index([quoteId])
  @@index([quoteStatus])
  @@index([nextReminderAt])
  @@index([subscriptionId])
  @@index([documentType, status])
  @@index([documentType, quoteStatus])
  @@index([clientId, documentType])
  project           ClientProject? @relation("QuoteProject")
  @@index([revolutOrderId])
}

model PaymentMilestone {
  id              String          @id @default(cuid())
  quoteId         String
  quote           Invoice         @relation("QuoteMilestones", fields: [quoteId], references: [id], onDelete: Cascade)
  position        Int
  label           String
  percentBps      Int
  amountCents     Int
  triggerText     String
  status          MilestoneStatus @default(PENDING)
  /// Date d'échéance du règlement (signature devis ou jalon projet)
  dueDate         DateTime?
  /// Revolut Merchant (encaissement en ligne)
  revolutOrderId    String?
  revolutPaymentId  String?
  /// 2e acompte du 3 fois : étape de projet qui l'a rendu exigible, et quand.
  triggerStepLabel  String?
  triggeredAt       DateTime?
  checkoutUrl       String?
  paidAt            DateTime?
  paymentMethod     PaymentMethod?
  manualReference   String?
  manualNotes       String?
  /// Facture générée pour ce jalon (dénormalisé, sync avec Invoice.milestoneId)
  invoiceId       String?
  /// Facture d'acompte/solde générée (lien 1-1 via Invoice.milestoneId)
  generatedInvoice Invoice?       @relation("MilestoneInvoice")
  webhookEvents   RevolutWebhookEvent[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([quoteId])
  @@index([status])
  @@index([invoiceId])
  @@index([dueDate])
  @@index([revolutOrderId])
}

model RevolutWebhookEvent {
  id          String    @id @default(cuid())
  /// Identifiant unique Revolut (idempotence)
  eventId     String    @unique
  eventType   String
  payload     Json
  processedAt DateTime  @default(now())
  milestoneId String?
  milestone   PaymentMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)

  @@index([milestoneId])
  @@index([eventType])
}

model InvoiceLine {
  id               String         @id @default(cuid())
  invoiceId        String
  invoice          Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  position         Int
  description      String
  quantity         Decimal
  unitPriceCents   Int
  lineTotalCents   Int
  /// Ligne d'abonnement mensuel (1ʳᵉ échéance dans le total du document)
  isSubscription   Boolean        @default(false)
  billingDay       Int?
  serviceId        String?
  service          Service?       @relation(fields: [serviceId], references: [id])
  /// Rempli quand le Subscription a été créé (idempotence)
  subscriptionId   String?
  subscription     Subscription?  @relation(fields: [subscriptionId], references: [id])

  @@index([invoiceId])
  @@index([serviceId])
  @@index([subscriptionId])
}

model Payment {
  id          String        @id @default(cuid())
  invoiceId   String?
  invoice     Invoice?      @relation(fields: [invoiceId], references: [id])
  amountCents Int
  paidAt      DateTime
  method      PaymentMethod @default(BANK_TRANSFER)
  reference   String?
  notes       String?
  /// Identifiant PaymentIntent Stripe (pi_…)
  stripePaymentIntentId String? @unique
  /// Frais Stripe (centimes) : information, hors livre des recettes
  feeCents    Int?
  /// Versement Stripe vers Revolut qui a inclus ce paiement
  stripePayoutId String?
  stripePayout   StripePayout? @relation(fields: [stripePayoutId], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())
  bankTransaction BankTransaction?

  @@index([invoiceId])
  @@index([paidAt])
  @@index([stripePayoutId])
}

/// Versement Stripe vers le compte bancaire (Revolut Pro).
model StripePayout {
  id              String    @id @default(cuid())
  /// Identifiant Payout Stripe (po_…)
  stripePayoutId  String    @unique
  amountCents     Int
  /// Date d'arrivée prévue sur le compte bancaire
  arrivalDate     DateTime?
  status          String
  /// Versement demandé depuis l'ERP (bouton « Verser ») : auteur et date ; null = versement automatique Stripe.
  requestedByEmail String?
  requestedAt     DateTime?
  /// Motif de l'échec renvoyé par Stripe (payout.failed)
  failureMessage  String?
  createdAt       DateTime  @default(now())
  payments        Payment[]

  @@index([arrivalDate])
  @@index([status])
}

/// Événement webhook Stripe traité (idempotence).
model StripeWebhookEvent {
  id          String   @id @default(cuid())
  /// Identifiant unique Stripe (evt_…)
  eventId     String   @unique
  eventType   String
  payload     Json
  processedAt DateTime @default(now())

  @@index([eventType])
  @@index([processedAt])
}

enum BankTxStatus {
  PENDING
  MATCHED
  UNMATCHED
  IGNORED
}

enum BankIgnoreCategory {
  FRAIS_BANCAIRES
  AUTRE
}

enum SalaryPayoutStatus {
  DRAFT
  PENDING_CONFIRMATION
  COMPLETED
  FAILED
  CANCELLED
}

/// Transaction importée depuis Revolut Business (crédits / débits).
model BankTransaction {
  id                 String              @id @default(cuid())
  /// ID unique Revolut (idempotence)
  revolutId          String              @unique
  bookedAt           DateTime
  /// Positif = crédit entrant (encaissement), négatif = débit
  amountCents        Int
  currency           String              @default("EUR")
  counterpartyName   String?
  counterpartyIban   String?
  reference          String?
  /// État brut Revolut (pending, completed, ...)
  revolutState       String?
  status             BankTxStatus        @default(UNMATCHED)
  ignoreCategory     BankIgnoreCategory?
  matchedInvoiceId   String?
  matchedInvoice     Invoice?            @relation(fields: [matchedInvoiceId], references: [id])
  paymentId          String?             @unique
  payment            Payment?            @relation(fields: [paymentId], references: [id])
  /// Suggestion JSON (ids factures + écarts) pour revue manuelle
  suggestionsJson    String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([status])
  @@index([bookedAt])
  @@index([amountCents])
  @@index([matchedInvoiceId])
}

model BankSyncLog {
  id            String   @id @default(cuid())
  startedAt     DateTime
  finishedAt    DateTime?
  imported      Int      @default(0)
  updated       Int      @default(0)
  matchedAuto   Int      @default(0)
  unmatched     Int      @default(0)
  errorMessage  String?
  createdAt     DateTime @default(now())

  @@index([startedAt])
}

/// Bénéficiaire virement (ex. compte perso) : PII chiffrées AES-GCM.
model RevolutBeneficiary {
  id             String   @id @default(cuid())
  label          String
  nameEncrypted  String
  ibanEncrypted  String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  payouts        SalaryPayout[]
}

model SalaryPayout {
  id              String             @id @default(cuid())
  amountCents     Int
  currency        String             @default("EUR")
  status          SalaryPayoutStatus @default(DRAFT)
  revolutDraftId  String?
  beneficiaryId   String?
  beneficiary     RevolutBeneficiary? @relation(fields: [beneficiaryId], references: [id])
  notes           String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([status])
  @@index([createdAt])
}

enum EmailOutboxStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

model EmailOutbox {
  id          String            @id @default(cuid())
  status      EmailOutboxStatus @default(PENDING)
  attempts    Int               @default(0)
  maxAttempts Int               @default(3)
  scheduledAt DateTime          @default(now())
  sentAt      DateTime?
  lastError   String?
  /// JSON : to, subject, text, html, headers, attachments, clientId, documentId, threadId, kind
  payload     String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([status, scheduledAt])
}

model EmailThread {
  id              String         @id @default(cuid())
  clientId        String?
  client          Client?        @relation(fields: [clientId], references: [id])
  subject         String
  participants    String         // JSON string[]
  lastMessageAt   DateTime
  hasAttachments  Boolean        @default(false)
  unreadCount     Int            @default(0)
  isStarred       Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  messages        EmailMessage[]

  quoteAcceptanceAudits QuoteAcceptanceAudit[]

  @@index([clientId])
  @@index([lastMessageAt])
  @@index([clientId, lastMessageAt])
  @@index([isStarred])
}

model QuoteAcceptanceAudit {
  id         String       @id @default(cuid())
  quoteId    String
  quote      Invoice      @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  signerName String
  /// PORTAL | THREAD | ADMIN
  source     String
  threadId   String?
  thread     EmailThread? @relation(fields: [threadId], references: [id], onDelete: SetNull)
  userId     String?
  userEmail  String?
  /// Preuve de signature (portail) : IP et navigateur du signataire.
  ipAddress  String?
  userAgent  String?
  /// PDF du devis signé, archivé dans data/uploads, et son empreinte SHA-256 (hex).
  pdfPath    String?
  pdfSha256  String?
  /// Signature portail : TYPED (nom saisi) | DRAWN (tracé au doigt ou à la souris)
  signatureMode   String?
  /// Tracé de la signature (data URL PNG), seulement en mode DRAWN
  signatureImage  String?
  /// Société représentée (client professionnel)
  signerCompany   String?
  /// Adresse ayant reçu le code de signature, masquée (j***@exemple.fr)
  verifiedEmailMasked String?
  codeVerifiedAt  DateTime?
  /// Devis tel que présenté au client juste avant sa signature, archivé, et son empreinte SHA-256
  originalPdfPath   String?
  originalPdfSha256 String?
  /// Formule de paiement retenue à la signature (TWO | THREE)
  paymentPlan       String?
  createdAt  DateTime     @default(now())

  @@index([quoteId])
  @@index([threadId])
}

model EmailMessage {
  id            String            @id @default(cuid())
  threadId      String
  thread        EmailThread       @relation(fields: [threadId], references: [id], onDelete: Cascade)
  folderId      String?
  folder        MailFolder?       @relation(fields: [folderId], references: [id], onDelete: SetNull)
  direction     EmailDirection
  messageId     String            @unique
  inReplyTo     String?
  referencesHeader String?
  fromAddress   String
  fromName      String?
  /// Reply-To d'un message entrant quand il diffère du From (formulaire Web3Forms : le prospect).
  replyToAddress String?
  toAddresses   String            // JSON string[]
  ccAddresses   String?           // JSON string[]
  subject       String
  snippet       String?
  bodyText      String?
  bodyHtml      String?
  bodyFetched   Boolean           @default(false)
  receivedAt    DateTime
  rawHeaders    String?
  isRead        Boolean           @default(false)
  isStarred     Boolean           @default(false)
  hasAttachments Boolean          @default(false)
  imapUid       Int?
  orphaned      Boolean           @default(false)
  createdAt     DateTime          @default(now())
  attachments   EmailAttachment[]

  @@index([threadId, receivedAt])
  @@index([fromAddress])
  @@index([folderId, imapUid])
  @@index([isRead])
  @@index([isStarred])
}

model EmailAttachment {
  id          String       @id @default(cuid())
  messageId   String
  message     EmailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  filename    String
  mimeType    String
  sizeBytes   Int
  storagePath String
  createdAt   DateTime     @default(now())

  @@index([messageId])
}

/// Curseur IMAP (UID) par boîte
model EmailSyncState {
  id           String   @id @default(cuid())
  mailbox      String   @unique
  lastUid      Int      @default(0)
  lastSyncedAt DateTime?
  updatedAt    DateTime @updatedAt
}

enum TestimonialStatus {
  PENDING
  PUBLISHED
  REJECTED
}

/// Avis client soumis depuis le portail de suivi, publié sur kouzia.com après validation.
model ClientTestimonial {
  id          String            @id @default(cuid())
  clientId    String
  client      Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  authorName  String
  body        String
  status      TestimonialStatus @default(PENDING)
  publishedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([clientId])
  @@index([status, publishedAt])
}
