# Copié vers /etc/kouzia/rsync.env par install.sh
# chmod 600. Ne jamais committer de secrets.

# Cible rsync des backups chiffrés (hôte Proxmox, NAS, VPS…)
# Exemples :
#   KOUZIA_RSYNC_TARGET="backup@192.168.1.10:/volume1/backups/kouzia/"
#   KOUZIA_RSYNC_TARGET="root@backup.example:/var/backup/kouzia-offsite/"
KOUZIA_RSYNC_TARGET=""

# Transport SSH custom (clé dédiée recommandée)
# KOUZIA_RSYNC_SSH="ssh -i /etc/kouzia/backup_id_ed25519 -o StrictHostKeyChecking=accept-new"

# 1 = supprimer sur la cible les fichiers absents localement (miroir strict)
KOUZIA_RSYNC_DELETE="0"
