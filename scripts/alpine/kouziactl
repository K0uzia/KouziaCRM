#!/usr/bin/env bash
# Point d'entrée unifié KouziaCRM (Alpine / Proxmox CT).
#
#   kouziactl              → menu interactif
#   kouziactl <cmd>        → commande directe
#   kouziactl cloudflare   → reconfigurer Cloudflare seul
# Installé dans /usr/local/bin/kouziactl par install.sh

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ ! -f "${SCRIPT_DIR}/lib.sh" ]]; then
  for candidate in \
    "${KOUZIA_APP_DIR:-/opt/kouziacrm}/scripts/alpine" \
    /opt/kouziacrm/scripts/alpine
  do
    if [[ -f "${candidate}/lib.sh" ]]; then
      SCRIPT_DIR="$candidate"
      break
    fi
  done
fi
[[ -f "${SCRIPT_DIR}/lib.sh" ]] || { echo "ERREUR: scripts alpine introuvables." >&2; exit 1; }

# shellcheck source=lib.sh
source "${SCRIPT_DIR}/lib.sh"

usage() {
  cat <<EOF
${C_BOLD}kouziactl${C_RESET} - gestion KouziaCRM (Alpine CT)

Usage:
  kouziactl                 Menu interactif
  kouziactl <commande> …    Commande directe

Commandes générales :
  install       Installation / réinstallation complète (root)
  configure     Assistant complet (toutes les étapes)
  summary       Récap accès (IP, status, config)
  update        Mise à jour code + deps sélectives + migrations
  backup        Backup SQLite chiffré (+ rsync offsite si configuré)
  restore       Restauration d'un backup .db.gpg
  status        État services, disque, healthcheck
  logs          Dernières lignes (app|worker|backup)
  restart       Redémarre app + worker
  stop / start  Arrête / démarre app + worker
  migrate       prisma migrate deploy
  help          Cette aide

Configuration par section (rejouable à tout moment) :
  access        WEB_ORIGIN, API_PORT, cookies / proxy
  admin         Email + mot de passe admin ERP
  site          Site public kouzia.com (CORS, /suivi, VITE_*)
  mail          SMTP / IMAP
  cloudflare    Token tunnel + service cloudflared
  rsync         Cible backup offsite

Exemples :
  kouziactl
  kouziactl cloudflare
  kouziactl admin
  kouziactl configure
  kouziactl update --git
EOF
}

run_configure_section() {
  bash "${SCRIPT_DIR}/configure.sh" "$1" "$@"
}

run_cmd() {
  local cmd="$1"
  shift || true
  case "$cmd" in
    install)
      KOUZIA_FORCE_INSTALL=1 bash "${SCRIPT_DIR}/install.sh" --yes "$@"
      ;;
    configure|config|wizard)
      bash "${SCRIPT_DIR}/configure.sh" all "$@"
      ;;
    access|admin|site|public|mail|email|smtp|cloudflare|tunnel|rsync)
      # Alias
      local section="$cmd"
      case "$cmd" in
        public) section="site" ;;
        email|smtp) section="mail" ;;
        tunnel) section="cloudflare" ;;
      esac
      bash "${SCRIPT_DIR}/configure.sh" "$section" "$@"
      ;;
    summary|access-summary)
      bash "${SCRIPT_DIR}/configure.sh" --summary-only
      ;;
    update|deploy)
      bash "${SCRIPT_DIR}/update.sh" "$@"
      ;;
    backup)
      bash "${SCRIPT_DIR}/backup.sh" "$@"
      ;;
    restore)
      bash "${SCRIPT_DIR}/restore.sh" "$@"
      ;;
    status)
      bash "${SCRIPT_DIR}/status.sh" "$@"
      ;;
    logs)
      local which="${1:-app}"
      case "$which" in
        app)    tail -n "${2:-80}" "${KOUZIA_LOG_DIR}/app.log" ;;
        worker) tail -n "${2:-80}" "${KOUZIA_LOG_DIR}/worker.log" ;;
        backup) tail -n "${2:-80}" "${KOUZIA_LOG_DIR}/backup.log" ;;
        *) die "logs: app|worker|backup" ;;
      esac
      ;;
    restart)
      require_root
      service_safe kouziacrm restart
      service_safe kouziacrm-worker restart
      wait_health
      ;;
    stop)
      require_root
      service_safe kouziacrm-worker stop
      service_safe kouziacrm stop
      ;;
    start)
      require_root
      service_safe kouziacrm start
      service_safe kouziacrm-worker start
      wait_health
      ;;
    migrate)
      require_cmd npx
      if [[ "$(id -u)" -eq 0 ]]; then
        run_as_app "cd '$KOUZIA_APP_DIR' && npx prisma migrate deploy"
      else
        (cd "$KOUZIA_APP_DIR" && npx prisma migrate deploy)
      fi
      ;;
    menu) show_menu ;;
    help|-h|--help) usage ;;
    *) die "Commande inconnue: $cmd (kouziactl help)" ;;
  esac
}

prompt_restore() {
  local f
  echo "Backups disponibles dans $KOUZIA_BACKUP_DIR :"
  ls -1t "$KOUZIA_BACKUP_DIR"/kouziacrm-*.db.gpg 2>/dev/null | head -10 || echo "  (aucun)"
  echo -n "Chemin du fichier .db.gpg à restaurer: "
  read -r f
  [[ -n "$f" ]] || { warn "Annulé."; return; }
  run_cmd restore "$f"
}

show_config_menu() {
  while true; do
    echo ""
    echo "${C_BOLD}── Configuration ──${C_RESET}"
    echo "  1) Assistant complet"
    echo "  2) Accès admin (WEB_ORIGIN / port)"
    echo "  3) Compte admin (email / mot de passe)"
    echo "  4) Site kouzia.com"
    echo "  5) Email SMTP / IMAP"
    echo "  6) Cloudflare Tunnel"
    echo "  7) Rsync offsite"
    echo "  8) Récap"
    echo "  b) Retour"
    echo -n "Choix: "
    local c
    read -r c
    case "$c" in
      1) run_cmd configure ;;
      2) run_cmd access ;;
      3) run_cmd admin ;;
      4) run_cmd site ;;
      5) run_cmd mail ;;
      6) run_cmd cloudflare ;;
      7) run_cmd rsync ;;
      8) run_cmd summary ;;
      b|B|q|Q) return ;;
      *) warn "Choix invalide" ;;
    esac
  done
}

show_menu() {
  while true; do
    echo ""
    echo "${C_BOLD}══════════════════════════════════════${C_RESET}"
    echo "${C_BOLD}  KouziaCRM  -  menu Alpine CT${C_RESET}"
    echo "${C_BOLD}══════════════════════════════════════${C_RESET}"
    echo "  1) Installer / réinstaller"
    echo "  2) Configuration (sous-menu)"
    echo "  3) Récap accès (IP / status)"
    echo "  4) Mettre à jour (incrémental)"
    echo "  5) Mettre à jour + git pull"
    echo "  6) Backup DB (+ rsync si configuré)"
    echo "  7) Restaurer un backup"
    echo "  8) Status détaillé"
    echo "  9) Logs (app)"
    echo " 10) Restart services"
    echo " 11) Stop services"
    echo " 12) Start services"
    echo " 13) Migrations Prisma seules"
    echo "  h) Aide CLI"
    echo "  q) Quitter"
    echo -n "Choix: "
    local choice
    read -r choice
    case "$choice" in
      1)
        echo -n "Confirmer installation complète ? [y/N] "
        local conf
        read -r conf
        [[ "$conf" == "y" || "$conf" == "Y" ]] || { warn "Annulé."; continue; }
        run_cmd install
        ;;
      2) show_config_menu ;;
      3) run_cmd summary ;;
      4) run_cmd update ;;
      5) run_cmd update --git ;;
      6) run_cmd backup ;;
      7) prompt_restore ;;
      8) run_cmd status ;;
      9) run_cmd logs app ;;
      10) run_cmd restart ;;
      11) run_cmd stop ;;
      12) run_cmd start ;;
      13) run_cmd migrate ;;
      h|H) usage ;;
      q|Q|0) echo "Bye."; exit 0 ;;
      *) warn "Choix invalide: $choice" ;;
    esac
  done
}

if [[ $# -eq 0 ]]; then
  show_menu
else
  run_cmd "$@"
fi
