#!/usr/bin/env bash
# Point d'entrée unifié KouziaCRM (Alpine / Proxmox CT).
#
#   kouziactl                 → menu interactif
#   kouziactl <cmd>           → commande directe
#   kouziactl cloudflare      → reconfigurer Cloudflare
# Installé dans /usr/local/bin/kouziactl par install.sh

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ ! -f "${SCRIPT_DIR}/lib.sh" ]]; then
  for candidate in \
    "${KOUZIA_APP_DIR:-/opt/kouziacrm}/scripts/alpine" \
    /opt/kouziacrm/scripts/alpine
  do
    if [[ -f "${candidate}/lib.sh" ]]; then
      SCRIPT_DIR="$candidate"
      break
    fi
  done
fi
[[ -f "${SCRIPT_DIR}/lib.sh" ]] || { echo "ERREUR: scripts alpine introuvables." >&2; exit 1; }

# shellcheck source=lib.sh
source "${SCRIPT_DIR}/lib.sh"

# --- UI ---

menu_clear_hint() {
  # Laisse un peu d'air sans clear (historique scrollable)
  echo ""
}

menu_box() {
  local title="$1"
  local line="══════════════════════════════════════════════"
  echo ""
  echo "${C_CYAN}╔${line}╗${C_RESET}"
  printf "${C_CYAN}║${C_RESET} ${C_BOLD}%-44s${C_RESET} ${C_CYAN}║${C_RESET}\n" "$title"
  echo "${C_CYAN}╚${line}╝${C_RESET}"
}

menu_section() {
  echo ""
  echo "  ${C_BOLD}$1${C_RESET}"
}

# Affiche une entrée : numéro, titre, description courte
menu_item() {
  local num="$1" title="$2" desc="${3:-}"
  printf "  ${C_GREEN}%2s${C_RESET}) %-28s" "$num" "$title"
  if [[ -n "$desc" ]]; then
    echo " ${C_YELLOW}$desc${C_RESET}"
  else
    echo ""
  fi
}

menu_back() {
  printf "  ${C_GREEN}%2s${C_RESET}) Retour\n" "b"
}

menu_prompt() {
  echo ""
  echo -n "  ${C_BOLD}Choix${C_RESET} › "
}

confirm_yn() {
  local prompt="$1" ans
  echo -n "  ${prompt} [y/N]: "
  read -r ans || true
  [[ "$ans" == "y" || "$ans" == "Y" ]]
}

pause_enter() {
  echo ""
  echo -n "  Entrée pour continuer…"
  read -r _ || true
}

usage() {
  cat <<EOF
${C_BOLD}kouziactl${C_RESET} - gestion KouziaCRM (Alpine CT)

Usage:
  kouziactl                 Menu interactif
  kouziactl <commande> …    Commande directe

Général :
  install / configure / summary / status / help

Mise à jour :
  update            Incrémental (code déjà sur le CT, pas de git pull)
  update --git      git pull puis incrémental

Config (rejouable) :
  access | admin | site | mail | cloudflare | rsync

Services / data :
  start | stop | restart | logs [app|worker|backup]
  backup | restore | migrate

Différence maj :
  incrémentale  = applique le code déjà présent (rsync/manuel),
                  npm/build seulement si lock ou front a changé
  + git pull    = récupère d'abord origin/main, puis même logique
EOF
}

run_cmd() {
  local cmd="$1"
  shift || true
  case "$cmd" in
    install)
      KOUZIA_FORCE_INSTALL=1 bash "${SCRIPT_DIR}/install.sh" --yes "$@"
      ;;
    configure|config|wizard)
      bash "${SCRIPT_DIR}/configure.sh" all "$@"
      ;;
    access|admin|site|public|mail|email|smtp|cloudflare|tunnel|rsync)
      local section="$cmd"
      case "$cmd" in
        public) section="site" ;;
        email|smtp) section="mail" ;;
        tunnel) section="cloudflare" ;;
      esac
      bash "${SCRIPT_DIR}/configure.sh" "$section" "$@"
      ;;
    summary|access-summary)
      bash "${SCRIPT_DIR}/configure.sh" --summary-only
      ;;
    update|deploy)
      bash "${SCRIPT_DIR}/update.sh" "$@"
      ;;
    backup)
      bash "${SCRIPT_DIR}/backup.sh" "$@"
      ;;
    restore)
      bash "${SCRIPT_DIR}/restore.sh" "$@"
      ;;
    status)
      bash "${SCRIPT_DIR}/status.sh" "$@"
      ;;
    logs)
      local which="${1:-app}"
      case "$which" in
        app)    tail -n "${2:-80}" "${KOUZIA_LOG_DIR}/app.log" ;;
        worker) tail -n "${2:-80}" "${KOUZIA_LOG_DIR}/worker.log" ;;
        backup) tail -n "${2:-80}" "${KOUZIA_LOG_DIR}/backup.log" ;;
        *) die "logs: app|worker|backup" ;;
      esac
      ;;
    restart)
      require_root
      service_safe kouziacrm restart
      service_safe kouziacrm-worker restart
      wait_health
      ;;
    stop)
      require_root
      service_safe kouziacrm-worker stop
      service_safe kouziacrm stop
      ;;
    start)
      require_root
      service_safe kouziacrm start
      service_safe kouziacrm-worker start
      wait_health
      ;;
    migrate)
      require_cmd npx
      if [[ "$(id -u)" -eq 0 ]]; then
        run_as_app "cd '$KOUZIA_APP_DIR' && npx prisma migrate deploy"
      else
        (cd "$KOUZIA_APP_DIR" && npx prisma migrate deploy)
      fi
      ;;
    menu) show_menu ;;
    help|-h|--help) usage ;;
    *) die "Commande inconnue: $cmd (kouziactl help)" ;;
  esac
}

prompt_restore() {
  echo ""
  echo "  Backups dans $KOUZIA_BACKUP_DIR :"
  ls -1t "$KOUZIA_BACKUP_DIR"/kouziacrm-*.db.gpg 2>/dev/null | head -10 | sed 's/^/    /' \
    || echo "    (aucun)"
  echo -n "  Chemin du .db.gpg à restaurer: "
  local f
  read -r f
  [[ -n "$f" ]] || { warn "Annulé."; return; }
  run_cmd restore "$f"
}

# --- Sous-menus ---

show_config_menu() {
  while true; do
    menu_clear_hint
    menu_box "Configuration"
    menu_section "Tout d'un coup"
    menu_item "1" "Assistant complet" "profil → accès → admin → site → mail → CF → rsync"
    menu_section "Par section"
    menu_item "2" "Accès ERP" "WEB_ORIGIN, port, COOKIE_SECURE"
    menu_item "3" "Compte admin" "email + mot de passe (+ seed)"
    menu_item "4" "Site kouzia.com" "CORS public, /suivi, VITE_*"
    menu_item "5" "Email" "SMTP / IMAP"
    menu_item "6" "Cloudflare Tunnel" "token + service cloudflared"
    menu_item "7" "Rsync offsite" "cible NAS / hôte distant"
    menu_section "Info"
    menu_item "8" "Récap config / IP" ""
    menu_back
    menu_prompt
    local c
    read -r c
    case "$c" in
      1) run_cmd configure; pause_enter ;;
      2) run_cmd access; pause_enter ;;
      3) run_cmd admin; pause_enter ;;
      4) run_cmd site; pause_enter ;;
      5) run_cmd mail; pause_enter ;;
      6) run_cmd cloudflare; pause_enter ;;
      7) run_cmd rsync; pause_enter ;;
      8) run_cmd summary; pause_enter ;;
      b|B|q|Q) return ;;
      *) warn "Choix invalide" ;;
    esac
  done
}

show_update_menu() {
  while true; do
    menu_clear_hint
    menu_box "Mise à jour"
    echo ""
    echo "  ${C_BOLD}Incrémentale${C_RESET}"
    echo "    Utilise le code déjà sur le CT (après rsync ou édité à la main)."
    echo "    → npm ci seulement si package-lock a changé"
    echo "    → rebuild SPA seulement si le front a changé"
    echo "    → migrations Prisma toujours"
    echo "    → pas de git pull"
    echo ""
    echo "  ${C_BOLD}+ git pull${C_RESET}"
    echo "    git pull --ff-only sur origin, puis exactement la même logique."
    echo "    → à utiliser si le CT suit le dépôt GitHub"
    echo ""
    menu_item "1" "Incrémentale" "code déjà là (rsync / local)"
    menu_item "2" "git pull + incrémentale" "récupère GitHub puis applique"
    menu_item "3" "Forcer npm + rebuild" "update --force (deps + SPA)"
    menu_back
    menu_prompt
    local c
    read -r c
    case "$c" in
      1) run_cmd update; pause_enter ;;
      2) run_cmd update --git; pause_enter ;;
      3)
        if confirm_yn "Forcer npm ci + rebuild SPA ?"; then
          run_cmd update --force
          pause_enter
        fi
        ;;
      b|B|q|Q) return ;;
      *) warn "Choix invalide" ;;
    esac
  done
}

show_backup_menu() {
  while true; do
    menu_clear_hint
    menu_box "Sauvegardes"
    menu_item "1" "Backup maintenant" "SQLite .backup + GPG (+ rsync si cible)"
    menu_item "2" "Restaurer un backup" "arrêt services → restore → restart"
    menu_item "3" "Configurer rsync" "cible offsite"
    menu_back
    menu_prompt
    local c
    read -r c
    case "$c" in
      1) run_cmd backup; pause_enter ;;
      2) prompt_restore; pause_enter ;;
      3) run_cmd rsync; pause_enter ;;
      b|B|q|Q) return ;;
      *) warn "Choix invalide" ;;
    esac
  done
}

show_services_menu() {
  while true; do
    menu_clear_hint
    menu_box "Services"
    menu_item "1" "Status" "santé API, IP, disque"
    menu_item "2" "Start" "app + worker"
    menu_item "3" "Stop" "worker puis app"
    menu_item "4" "Restart" "app + worker + healthcheck"
    menu_item "5" "Logs app" "dernières lignes"
    menu_item "6" "Logs worker" ""
    menu_item "7" "Logs backup" ""
    menu_item "8" "Migrations Prisma" "migrate deploy seul"
    menu_back
    menu_prompt
    local c
    read -r c
    case "$c" in
      1) run_cmd status; pause_enter ;;
      2) run_cmd start; pause_enter ;;
      3) run_cmd stop; pause_enter ;;
      4) run_cmd restart; pause_enter ;;
      5) run_cmd logs app; pause_enter ;;
      6) run_cmd logs worker; pause_enter ;;
      7) run_cmd logs backup; pause_enter ;;
      8) run_cmd migrate; pause_enter ;;
      b|B|q|Q) return ;;
      *) warn "Choix invalide" ;;
    esac
  done
}

# --- Menu principal ---

show_menu() {
  while true; do
    menu_clear_hint
    menu_box "KouziaCRM  ·  Alpine CT"
    local ip_hint=""
    if command -v ip >/dev/null 2>&1; then
      ip_hint="$(ip -4 -o addr show scope global 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -1 || true)"
    fi
    if [[ -n "$ip_hint" ]]; then
      echo "  Hôte : $(hostname)  ·  LAN : http://${ip_hint}:$(grep -E '^API_PORT=' "${KOUZIA_APP_DIR}/.env" 2>/dev/null | tail -1 | cut -d= -f2- | tr -d '"' || echo 3000)"
    else
      echo "  Hôte : $(hostname)"
    fi

    menu_section "Installation & config"
    menu_item "1" "Installer / réinstaller" "apk, npm, services (long)"
    menu_item "2" "Configuration…" "complet ou par section"
    menu_item "3" "Récap accès" "IP, URLs, status court"

    menu_section "Mise à jour & données"
    menu_item "4" "Mise à jour…" "incrémentale ou + git pull"
    menu_item "5" "Sauvegardes…" "backup / restore / rsync"

    menu_section "Exploitation"
    menu_item "6" "Services…" "start stop restart logs"
    menu_item "7" "Aide CLI" "liste des commandes"

    echo ""
    printf "  ${C_GREEN}%2s${C_RESET}) Quitter\n" "q"
    menu_prompt
    local choice
    read -r choice
    case "$choice" in
      1)
        if confirm_yn "Lancer une installation / réinstallation complète ?"; then
          run_cmd install
          pause_enter
        fi
        ;;
      2) show_config_menu ;;
      3) run_cmd summary; pause_enter ;;
      4) show_update_menu ;;
      5) show_backup_menu ;;
      6) show_services_menu ;;
      7|h|H) usage; pause_enter ;;
      q|Q|0) echo "  Bye."; exit 0 ;;
      *) warn "Choix invalide: $choice" ;;
    esac
  done
}

if [[ $# -eq 0 ]]; then
  show_menu
else
  run_cmd "$@"
fi
