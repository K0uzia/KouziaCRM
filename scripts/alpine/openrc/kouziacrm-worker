#!/sbin/openrc-run
# OpenRC : worker Kouzia ERP (IMAP + cron métier via node-cron)
# conf.d : /etc/conf.d/kouziacrm-worker

description="Kouzia ERP worker (IMAP / relances)"

: "${KOUZIA_APP_DIR:=/opt/kouziacrm}"
: "${KOUZIA_USER:=kouzia}"
: "${KOUZIA_GROUP:=kouzia}"

name="kouziacrm-worker"
command="${KOUZIA_APP_DIR}/node_modules/.bin/tsx"
command_args="--env-file=${KOUZIA_APP_DIR}/.env --tsconfig apps/api/tsconfig.json scripts/worker.ts"
command_user="${KOUZIA_USER}:${KOUZIA_GROUP}"
directory="${KOUZIA_APP_DIR}"
# Fichiers créés par le service (base, pièces jointes) : lisibles par lui seul.
umask=077
# supervise-daemon relance le processus s'il s'arrête (crash, exception non gérée) :
# 10 relances au plus par fenêtre de 60 s, au-delà le service reste arrêté (visible dans status).
supervisor=supervise-daemon
respawn_delay=5
respawn_max=10
respawn_period=60

output_log="/var/log/kouzia/worker.log"
error_log="/var/log/kouzia/worker.err"

depend() {
  need net
  after kouziacrm
  use kouziacrm
}

start_pre() {
  # Dossier à root (logrotate et root y écrivent sans piège de lien), fichiers au compte du service.
  checkpath -d -o root:root -m 0755 /var/log/kouzia
  checkpath -f -o "${KOUZIA_USER}:${KOUZIA_GROUP}" -m 0640 "$output_log" "$error_log"
  if [ ! -x "$command" ]; then
    eerror "tsx introuvable: $command"
    return 1
  fi
}
