{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "paths": {
      "@/*": ["./apps/api/src/*"]
    }
  },
  "include": ["apps/api/src/**/*.ts", "apps/api/src/**/*.tsx", "scripts/**/*.ts", "prisma/**/*.ts"],
  "exclude": ["node_modules", "apps/web"]
}
